// Issue #52: single source of truth for the default container image
// references used by the GS panel lineage (modules/local/gs_normalize_variants.nf,
// classify_normalized_variants.nf, gs_index_classified_variants.nf,
// gatk_variantfiltration.nf, gatk_selectpassvariants.nf, build_gs_panel.nf,
// reconcile_gs_panel_accounting.nf). Each of those processes' own `container`
// directive reads its digest from here instead of repeating the literal, so
// bumping a pinned image is a one-line change in this file rather than a
// module-file edit plus a separate manual update of whatever previously
// re-declared the same digest elsewhere (workflows/adzuki_snp_pipeline.nf
// used to keep its own copy for BUILD_GS_PANEL_MANIFEST; see that workflow
// file for why it no longer does).
//
// This registry defines *defaults* only. It is deliberately not the
// mechanism that makes the GS panel manifest trustworthy: a `withName`,
// process-alias, fully-qualified-selector, profile, or external-config
// override can still replace any of these values for a specific task, and
// Nextflow gives no way to introspect from here whether that happened. The
// manifest instead records each GS process's own `task.container` --
// Nextflow's already-resolved, post-override effective value -- captured
// from inside that exact task (see the `container_id` output added to each
// process above, and BUILD_GS_PANEL_MANIFEST's `--container-*` arguments in
// workflows/adzuki_snp_pipeline.nf). Changing a value here changes what
// actually runs and therefore automatically changes what gets recorded --
// the two can no longer drift out of sync by one being edited without the
// other.
params {
    containers = [
        bcftools: 'quay.io/biocontainers/bcftools:1.24--h118bc1c_2@sha256:a3e0d3007ffe325c409b398f660840a3e7574d076219c6e82fc994ced87d47c3',
        gatk    : 'broadinstitute/gatk:4.6.2.0@sha256:71b17ee42d149e8ec112603f5305c873ab60d93949ef8bb62a4fff85427f56fb',
        python  : 'python:3.12@sha256:dd4fe98ab39f91e936f8e7e7a65a3ce59ecfb11e32f9a125b3132779920ba7f7',
    ]
}
