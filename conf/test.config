params {
    input               = "${projectDir}/tests/data/samplesheet.csv"
    outdir              = "${projectDir}/results"
    reference_id        = 'synthetic-adzuki-v1'
    reference_name      = 'Synthetic adzuki test reference'
    reference_fasta     = "${projectDir}/tests/data/reference/synthetic.fa"
    reference_species   = 'Vigna angularis'
    reference_cultivar  = 'synthetic'
}

process {
    withLabel: process_low {
        cpus   = 2
        memory = '2 GB'
        time   = '30m'
    }

    withLabel: process_medium {
        cpus   = 2
        memory = '3 GB'
        time   = '30m'
    }

    withLabel: process_high {
        cpus   = 2
        memory = '4 GB'
        time   = '30m'
    }

    withLabel: process_mapping {
        cpus   = 2
        memory = '4 GB'
        time   = '30m'
    }

    withLabel: process_bwa_index {
        cpus   = 2
        memory = '4 GB'
        time   = '30m'
    }

    withLabel: process_genomicsdb {
        cpus   = 2
        memory = '4 GB'
        time   = '30m'
    }
}
