config {

    testsDir "tests"
    workDir ".nf-test"
    configFile "tests/nextflow.config"
    // Issue #52: shared Groovy helpers for tests (GsContainerDefaults reads
    // the GS lineage's default container references out of
    // conf/containers.config instead of tests copying pinned digests).
    libDir "tests/lib"
    profile "test,docker"

}
