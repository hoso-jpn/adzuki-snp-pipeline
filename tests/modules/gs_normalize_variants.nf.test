nextflow_process {

    name "GS_NORMALIZE_VARIANTS multiallelic and MIXED-record splitting contract"
    script "modules/local/gs_normalize_variants.nf"
    process "GS_NORMALIZE_VARIANTS"

    // Reuses tests/modules/fixtures/mixed_type_contract.vcf.gz (Issue #15):
    //   chrSynthetic1:1000  REF=A  ALT=G       (pure SNP)
    //   chrSynthetic1:2000  REF=T  ALT=TAAA    (pure indel, insertion)
    //   chrSynthetic1:3000  REF=C  ALT=T,CAAA  (MIXED: one SNP-type
    //                                          allele + one indel-type
    //                                          allele at the same site),
    //                                          sample_a=0/1 (carries T),
    //                                          sample_b=0/2 (carries CAAA)
    //
    // Real output confirmed by running this exact fixture through the
    // pinned bcftools 1.24 container directly before writing this test
    // (not assumed): the MIXED record splits into two biallelic rows at
    // the same position, and each sample's genotype is recoded relative
    // to its own split allele (0/1 semantics per split, not the
    // original multiallelic allele index) rather than preserved as-is.

    test("a MIXED record splits into a SNP-shaped row and an indel-shaped row, with genotypes recoded per split allele") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'mixed_contract' ],
                    file("${projectDir}/tests/modules/fixtures/mixed_type_contract.vcf.gz"),
                    file("${projectDir}/tests/modules/fixtures/mixed_type_contract.vcf.gz.tbi"),
                ]
                input[1] = [
                    [ id: 'synthetic' ],
                    file("${projectDir}/tests/data/reference/synthetic.fa"),
                ]
                input[2] = [
                    [ id: 'synthetic' ],
                    file("${projectDir}/tests/data/reference/synthetic.fa.fai"),
                ]
                """
            }
        }

        then {
            assert process.success

            def records = path(process.out.vcf[0][1])
                .linesGzip
                .findAll { line -> !line.startsWith("#") }
                .collect { line -> line.split("\t") }

            // pure SNP and pure indel pass through unsplit; the MIXED
            // record becomes two rows at the same position
            assert records.size() == 4
            assert records[0][1] == "1000" && records[0][3] == "A" && records[0][4] == "G"
            assert records[1][1] == "2000" && records[1][3] == "T" && records[1][4] == "TAAA"

            def mixedSplitRows = records.findAll { fields -> fields[1] == "3000" }
            assert mixedSplitRows.size() == 2

            def snpShapedChild = mixedSplitRows.find { fields -> fields[4] == "T" }
            def indelShapedChild = mixedSplitRows.find { fields -> fields[4] == "CAAA" }
            assert snpShapedChild != null: "no split child with ALT=T found"
            assert indelShapedChild != null: "no split child with ALT=CAAA found"
            assert snpShapedChild[3] == "C"
            assert indelShapedChild[3] == "C"

            // sample_a originally carried the T allele (0/1) and
            // sample_b originally carried the CAAA allele (0/2); each
            // split child's GT must be recoded relative to its own
            // allele, not the original multiallelic allele index
            def snpShapedGenotypes = snpShapedChild[9..10]
            def indelShapedGenotypes = indelShapedChild[9..10]
            assert snpShapedGenotypes[0].startsWith("0/1")
            assert snpShapedGenotypes[1].startsWith("0/0")
            assert indelShapedGenotypes[0].startsWith("0/0")
            assert indelShapedGenotypes[1].startsWith("0/1")

            // Issue #52: with no override configured, the effective
            // container this task actually ran in (task.container,
            // emitted as container_id) must equal the single default-
            // value source of truth in conf/containers.config.
            assert process.out.container_id[0] ==
                'quay.io/biocontainers/bcftools:1.24--h118bc1c_2@sha256:a3e0d3007ffe325c409b398f660840a3e7574d076219c6e82fc994ced87d47c3'
        }
    }

    test("a reference mismatch is caught and fails the process rather than silently normalizing") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'ref_mismatch' ],
                    file("${projectDir}/tests/modules/fixtures/gs_normalize_ref_mismatch.vcf.gz"),
                    file("${projectDir}/tests/modules/fixtures/gs_normalize_ref_mismatch.vcf.gz.tbi"),
                ]
                input[1] = [
                    [ id: 'synthetic' ],
                    file("${projectDir}/tests/data/reference/synthetic.fa"),
                ]
                input[2] = [
                    [ id: 'synthetic' ],
                    file("${projectDir}/tests/data/reference/synthetic.fa.fai"),
                ]
                """
            }
        }

        then {
            assert !process.success
        }
    }

    test("an empty (header-only) VCF completes without error and produces zero records") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'empty' ],
                    file("${projectDir}/tests/modules/fixtures/gs_normalize_empty.vcf.gz"),
                    file("${projectDir}/tests/modules/fixtures/gs_normalize_empty.vcf.gz.tbi"),
                ]
                input[1] = [
                    [ id: 'synthetic' ],
                    file("${projectDir}/tests/data/reference/synthetic.fa"),
                ]
                input[2] = [
                    [ id: 'synthetic' ],
                    file("${projectDir}/tests/data/reference/synthetic.fa.fai"),
                ]
                """
            }
        }

        then {
            assert process.success

            def records = path(process.out.vcf[0][1])
                .linesGzip
                .findAll { line -> !line.startsWith("#") }
            assert records.size() == 0
        }
    }

    // Issue #52 regression: a previous version of the GS panel manifest
    // recorded a hardcoded literal here rather than this process's own
    // effective container, so a `withName` override on GS_NORMALIZE_VARIANTS
    // would have gone completely unnoticed. This proves task.container
    // itself (not yet the manifest -- see tests/pipeline/adzuki_snp_pipeline.nf.test
    // for the end-to-end wiring) reflects the override, not the module's
    // own `container` directive default.
    test("a withName override changes the recorded container_id, not just the running container") {

        config "./fixtures/gs_normalize_variants_container_override.config"

        when {
            process {
                """
                input[0] = [
                    [ id: 'empty' ],
                    file("${projectDir}/tests/modules/fixtures/gs_normalize_empty.vcf.gz"),
                    file("${projectDir}/tests/modules/fixtures/gs_normalize_empty.vcf.gz.tbi"),
                ]
                input[1] = [
                    [ id: 'synthetic' ],
                    file("${projectDir}/tests/data/reference/synthetic.fa"),
                ]
                input[2] = [
                    [ id: 'synthetic' ],
                    file("${projectDir}/tests/data/reference/synthetic.fa.fai"),
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.container_id[0] == 'quay.io/biocontainers/bcftools:1.24--h118bc1c_2'
            assert process.out.container_id[0] !=
                'quay.io/biocontainers/bcftools:1.24--h118bc1c_2@sha256:a3e0d3007ffe325c409b398f660840a3e7574d076219c6e82fc994ced87d47c3'
        }
    }
}
