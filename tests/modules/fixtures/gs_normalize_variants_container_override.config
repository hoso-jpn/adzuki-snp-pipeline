// Issue #52 regression fixture: overrides GS_NORMALIZE_VARIANTS's
// container with the exact same underlying image, referenced without its
// `@sha256:...` digest suffix, so the run needs no extra image pull (the
// content is already cached from every default-config test in this file)
// while the value is still a distinct string from the hardcoded default --
// which is what tests/modules/gs_normalize_variants.nf.test actually
// checks for.
process {
    withName: '^GS_NORMALIZE_VARIANTS$' {
        container = 'quay.io/biocontainers/bcftools:1.24--h118bc1c_2'
    }
}
