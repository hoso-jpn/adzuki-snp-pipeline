// Issue #52 regression fixture: overrides GS_NORMALIZE_VARIANTS's container
// with the same underlying image referenced by digest alone (its tag
// dropped), so the run needs no extra image pull -- the content is already
// cached from every default-config test in this file -- while the value is
// still a distinct string from the default, which is what
// tests/modules/gs_normalize_variants.nf.test actually checks for.
//
// The value is derived from conf/containers.config rather than written out
// here, so this fixture holds no copy of a pinned production digest and
// keeps working unchanged when one is bumped. `includeConfig` is required
// for that: `params` set by another config file is not visible while this
// one is parsed, only `params` from a file this one includes itself.
// GsContainerDefaults.digestOnly() in tests/lib/ applies the identical
// transformation so the test can state what it expects to see.
includeConfig '../../../conf/containers.config'

process {
    withName: '^GS_NORMALIZE_VARIANTS$' {
        container = params.containers.bcftools.replaceFirst(/:[^@]+@/, '@')
    }
}
