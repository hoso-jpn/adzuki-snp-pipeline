// Issue #52 regression fixture: overrides GATK_VARIANTFILTRATION's
// container with the exact same underlying image, referenced without its
// `@sha256:...` digest suffix, so the run needs no extra image pull while
// the value is still a distinct string from the hardcoded default -- which
// is what tests/modules/gatk_variantfiltration.nf.test actually checks
// for. Anchored (`^...$`) so it matches only this exact process name, not
// GATK_VARIANTFILTRATION_GS (see Nextflow's own withName regex-matching
// caveat: an unanchored pattern can match more than one process name).
process {
    withName: '^GATK_VARIANTFILTRATION$' {
        container = 'broadinstitute/gatk:4.6.2.0'
    }
}
