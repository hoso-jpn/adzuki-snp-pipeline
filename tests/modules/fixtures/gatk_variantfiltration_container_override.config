// Issue #52 regression fixture: overrides GATK_VARIANTFILTRATION's container
// with the same underlying image referenced by digest alone (its tag
// dropped), so the run needs no extra image pull while the value is still a
// distinct string from the default -- which is what
// tests/modules/gatk_variantfiltration.nf.test actually checks for. Anchored
// (`^...$`) so it matches only this exact process name, not
// GATK_VARIANTFILTRATION_GS (see Nextflow's own withName regex-matching
// caveat: an unanchored pattern can match more than one process name).
//
// See tests/modules/fixtures/gs_normalize_variants_container_override.config
// for why the value is derived from conf/containers.config through an
// `includeConfig` rather than written out as a literal digest here.
includeConfig '../../../conf/containers.config'

process {
    withName: '^GATK_VARIANTFILTRATION$' {
        container = params.containers.gatk.replaceFirst(/:[^@]+@/, '@')
    }
}
