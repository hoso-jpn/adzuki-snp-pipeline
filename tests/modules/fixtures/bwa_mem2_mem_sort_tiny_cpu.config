// PR #25 review (P1-1) regression fixture: task.cpus=1 gives
// bwa-mem2 and samtools sort exactly one thread each to fight over
// (both need >= 1 of their own since they run concurrently in the
// same pipe), which the process must now reject before running
// rather than silently oversubscribing a single CPU.
process {
    withName: 'BWA_MEM2_MEM_SORT' {
        cpus = 1
        memory = '4 GB'
    }
}
