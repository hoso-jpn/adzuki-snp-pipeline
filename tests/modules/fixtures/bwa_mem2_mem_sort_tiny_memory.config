// PR #25 review (P1-1) regression fixture: task.memory=1024 MB splits
// into bwa_share_mib=512 + os_overhead_mib=512, leaving 0 MiB for
// samtools sort's own thread(s) -- below the 1 MiB/thread floor. The
// process must reject this before running rather than silently
// clamping sort's per-thread memory up and exceeding task.memory.
process {
    withName: 'BWA_MEM2_MEM_SORT' {
        cpus = 2
        memory = '1024 MB'
    }
}
