nextflow_pipeline {

    name "Joint Genotyping fixture: ref/alt genotype and annotation contract"
    script "main.nf"

    // Issue #11: nf-test's own workflow.trace.tasks() exposes only
    // `name`/`success` per task, not a work directory -- so the real,
    // fully-rendered `.command.sh` Nextflow generated for each task is
    // located directly on disk instead, by walking down from `outputDir`'s
    // sibling `work/` directory. `*.genomicsdb` directories are skipped
    // during the walk: GenomicsDBImport's docker container runs as root
    // and leaves its own workspace directory root-owned and
    // world-unreadable (0700) on the host, which would otherwise make
    // this walk itself throw AccessDeniedException on that subtree.
    def findCommandScripts = { String testOutputDir, String needle ->
        def testRoot = new File(testOutputDir).getParentFile()
        def matches = []
        def walk
        walk = { File dir ->
            dir.listFiles()?.each { entry ->
                if (entry.isDirectory() && !entry.name.endsWith(".genomicsdb")) {
                    walk(entry)
                } else if (entry.name == ".command.sh" && entry.text.contains(needle)) {
                    matches << entry.text
                }
            }
        }
        walk(testRoot)
        return matches
    }

    // Issue #52: same walk as findCommandScripts above, but returns each
    // matched task's sibling `.command.run` instead of `.command.sh` --
    // that file's `nxf_launch()` function embeds the literal `docker run
    // ... <image> ...` invocation Nextflow actually used for that task,
    // which is how a real container override (as opposed to the
    // GS-lineage-only `container_id` outputs this Issue adds) can be
    // confirmed never to have leaked onto an unrelated task.
    def findCommandRunScripts = { String testOutputDir, String needle ->
        def testRoot = new File(testOutputDir).getParentFile()
        def matches = []
        def walk
        walk = { File dir ->
            dir.listFiles()?.each { entry ->
                if (entry.isDirectory() && !entry.name.endsWith(".genomicsdb")) {
                    walk(entry)
                } else if (entry.name == ".command.sh" && entry.text.contains(needle)) {
                    def runFile = new File(entry.getParentFile(), ".command.run")
                    if (runFile.exists()) {
                        matches << runFile.text
                    }
                }
            }
        }
        walk(testRoot)
        return matches
    }

    // Issue #42: an independent SHA-256 of a file on disk, so a manifest
    // checksum can be checked against the actual bytes of the fixture
    // rather than against a value copied out of the manifest itself.
    def sha256Of = { String filePath ->
        def digest = java.security.MessageDigest.getInstance("SHA-256")
        new File(filePath).eachByte(1048576) { buffer, length ->
            digest.update(buffer, 0, length)
        }
        return "sha256:" + digest.digest().collect { byteValue ->
            String.format("%02x", byteValue)
        }.join()
    }

    // Issue #42: the canonical process keys of every process Nextflow
    // actually executed, derived from its own task trace rather than
    // from a list maintained by hand here.
    //
    // This is what makes "the manifest records every executed process"
    // self-maintaining: a process added to the workflow later but never
    // wired into the run-level provenance channel would show up in the
    // trace and not in the manifest, and the comparison below would
    // fail -- whereas a hand-written expected list would simply not
    // mention it, and would pass.
    //
    // A trace name looks like `ADZUKI_SNP_PIPELINE:FASTQC_RAW (tag)`;
    // the canonical key is the invocation name (which is the *alias*,
    // not the module's own process name) lowercased.
    def executedProcessKeys = { taskNames ->
        return taskNames.collect { name ->
            name.replaceAll(/\s*\(.*\)\s*$/, '')
                .tokenize(':')
                .last()
                .toLowerCase()
        } as Set
    }

    // Issue #42: the run-level provenance manifest a successful run now
    // always publishes, at its stable public path.
    def readRunManifest = { String testOutputDir ->
        def manifestFile = new File("${testOutputDir}/provenance/cohort.run_manifest.json")
        assert manifestFile.exists(): "no run manifest at ${manifestFile}"
        return new groovy.json.JsonSlurper().parse(manifestFile)
    }

    // Issue #42: one needle per *non-GS* process key, matching exactly one
    // task's rendered `.command.sh`, so the manifest's recorded container
    // for that process can be compared against the image Nextflow really
    // launched it with. The GS lineage's own keys are covered by
    // GS_TASK_NEEDLES below; MULTIQC's presence is what proves the
    // manifest cannot be written before the QC side branch finishes.
    def RUN_TASK_NEEDLES = [
        fastqc_raw                   : '.raw.R1.fastq.gz',
        fastqc_trimmed               : '.trimmed.R1.fastq.gz',
        fastp                        : '--detect_adapter_for_pe',
        validate_reference_contigs   : 'validate_reference_contigs.py',
        bwa_mem2_mem_sort            : 'bwa-mem2 mem',
        samtools_merge               : 'samtools merge',
        gatk_markduplicates          : 'MarkDuplicates',
        samtools_index               : 'samtools index',
        samtools_qc                  : 'samtools flagstat',
        multiqc                      : 'multiqc',
        gatk_haplotypecaller         : 'HaplotypeCaller',
        gatk_genomicsdbimport        : 'GenomicsDBImport',
        gatk_genotypegvcfs           : 'GenotypeGVCFs',
        gatk_gathervcfs              : 'GatherVcfs',
        gatk_selectvariants          : '--output cohort.snp.vcf.gz',
        gatk_variantfiltration       : '--output cohort.snp.filtered.vcf.gz',
        gatk_selectpassvariants      : '--output cohort.snp.pass.vcf.gz',
        bcftools_stats               : 'bcftools stats',
        summarize_variant_qc         : 'summarize_variant_qc.py',
        summarize_filter_qc          : 'summarize_filter_qc.py',
        reconcile_variant_type_counts: 'reconcile_variant_type_counts.py',
        hash_input_fastqs            : 'hash_input_fastqs.py',
        hash_reference_bundle        : 'hash_reference_bundle.py',
        hash_run_artifacts           : 'hash_run_artifacts.py',
        build_run_manifest           : 'build_run_manifest.py',
    ]

    // Issue #42: the reference-preparation processes that run only when
    // the pipeline was not given a prebuilt bundle. Their keys must be
    // present in a run that generated them and absent from one that did
    // not -- the manifest lists processes this run executed, not
    // processes it could have.
    def OPTIONAL_REFERENCE_TASK_NEEDLES = [
        samtools_faidx                 : 'samtools faidx',
        gatk_create_sequence_dictionary: 'CreateSequenceDictionary',
        bwa_mem2_index                 : 'bwa-mem2 index',
    ]

    // Issue #52: a needle that appears in exactly one GS-lineage task's
    // `.command.sh`, per manifest `containers` key, so a test can pull up
    // that task's real `.command.run` (and therefore the image Nextflow
    // actually launched it with) and compare it against the identity the
    // manifest recorded for the very same process. Each needle is a
    // fragment of that process's own rendered command rather than a
    // filename it merely shares with a neighbour: `cohort_gs.normalized.vcf.gz`,
    // for instance, appears in CLASSIFY_NORMALIZED_VARIANTS's command as an
    // input as well as in GS_NORMALIZE_VARIANTS's as an output.
    def GS_TASK_NEEDLES = [
        gs_normalize_variants        : 'bcftools norm',
        classify_normalized_variants : 'classify_normalized_variants.py',
        gs_index_classified_variants : 'bcftools view --output-type z --output cohort_gs.classified.vcf.gz',
        gatk_variantfiltration_gs    : '--output cohort_gs.snp.filtered.vcf.gz',
        gatk_selectpassvariants_gs   : '--output cohort_gs.snp.pass.vcf.gz',
        build_gs_panel               : '--matrix-output cohort.gs_panel.genotype_matrix.tsv.gz',
        reconcile_gs_panel_accounting: 'reconcile_gs_panel_accounting.py',
        build_gs_panel_manifest      : 'build_gs_panel_manifest.py',
    ]

    test("both samples resolve confident ref/alt genotypes at both deterministic SNP loci") {

        // Also the Issue #42 acceptance case: this run publishes the
        // run-level provenance manifest, asserted at the end of the
        // `then` block below.
        tag "issue42_run_manifest"


        when {
            params {
                // nf-test executes the pipeline outside the project
                // root, so the samplesheet's paths (relative to the
                // project root, as required for the documented
                // `nextflow run .` invocation) do not resolve as-is.
                // Rewrite them to absolute paths for this run only.
                def sourceLines = file("${projectDir}/tests/data/samplesheet.csv").readLines()
                def rewrittenLines = sourceLines.collect { line ->
                    line.replaceAll(
                        "tests/data/reads/",
                        "${projectDir}/tests/data/reads/"
                    )
                }
                def absoluteSamplesheet = new File("${outputDir}/samplesheet.absolute.csv")
                absoluteSamplesheet.text = rewrittenLines.join("\n") + "\n"

                outdir = "$outputDir"
                input = absoluteSamplesheet.toString()
                // Issue #20 review (P1-1): set as a String, not a bare
                // Groovy integer literal, to reproduce exactly what
                // Nextflow's strict CLI parser hands `params` for a real
                // `--sample_ploidy 2` invocation. This is the regression
                // guard for the bug where `params.sample_ploidy != 2`
                // compared a String "2" against the Integer 2 and was
                // always true, incorrectly fail-fasting even for the
                // correct, explicit default -- the previous version of
                // this test left sample_ploidy unset and could not have
                // caught it.
                sample_ploidy = "2"
                // Issue #8: a CLI-equivalent String, not a bare Groovy
                // integer literal (see the sample_ploidy comment above
                // for why this matters), and deliberately NOT the
                // default (100) so that a passing assertion below can
                // only mean this value was actually propagated to the
                // real GATK MarkDuplicates command, not just that the
                // default happened to already satisfy it.
                optical_duplicate_pixel_distance = "2500"
            }
        }

        then {
            assert workflow.success

            // Issue #11: the default genomicsdb_batch_size (50) and the
            // 80%-of-task.memory Xmx ceiling actually reach the real
            // GenomicsDBImport invocation for every interval task, not
            // just one of them -- read directly from each task's own
            // rendered .command.sh rather than inferred from output
            // equivalence (a 2-sample synthetic fixture's raw VCF would
            // look identical regardless of --batch-size). conf/test.config's
            // process_genomicsdb is cpus=2/memory='4 GB': 4096 MiB * 0.8
            // floored is 3276 MiB, a value computed here from the same
            // config, not hardcoded independently of it.
            def genomicsDbScripts = findCommandScripts("$outputDir", "GenomicsDBImport")
            assert genomicsDbScripts.size() == 2: "expected one GenomicsDBImport task per contig interval (chrSynthetic1, chrSynthetic2)"
            genomicsDbScripts.each { script ->
                assert script.contains("--batch-size 50")
                assert script.contains('-Xmx3276m')
                assert script.contains("--reader-threads 2")
            }

            // Issue #8: exactly one BWA_MEM2_MEM_SORT task per read
            // group (3: sample_a_L001, sample_a_L002, sample_b_L001),
            // and no standalone SAMTOOLS_SORT task at all -- the two
            // tools now run inside a single piped task instead.
            def taskNames = workflow.trace.tasks().collect { task -> task.name }
            def mappingTasks = taskNames.findAll { name -> name.contains("BWA_MEM2_MEM_SORT") }
            assert mappingTasks.size() == 3
            assert taskNames.every { name -> !name.contains("SAMTOOLS_SORT") }

            // Issue #17: the variant-filtering lineage's task cardinality,
            // re-measured against current main rather than taken from Issue
            // #17's own "SNP/indel each 2 tasks" wording -- that wording
            // predates the GS panel lineage (Issue #18), which adds its own
            // GATK_VARIANTFILTRATION_GS/GATK_SELECTPASSVARIANTS_GS tasks
            // reusing the same two modules. Matched on "NAME (" so the
            // aliased _GS processes are counted separately rather than
            // swept up by a substring match on the base name. Dropping
            // GATK_SELECTVARIANTS's duplicate val(variant_type) input must
            // not change any of these counts.
            def tasksNamed = { String processName ->
                taskNames.findAll { name -> name.contains("${processName} (") }
            }
            assert tasksNamed("GATK_SELECTVARIANTS").size() == 2
            assert tasksNamed("GATK_VARIANTFILTRATION").size() == 2
            assert tasksNamed("GATK_SELECTPASSVARIANTS").size() == 2
            assert tasksNamed("GATK_VARIANTFILTRATION_GS").size() == 1
            assert tasksNamed("GATK_SELECTPASSVARIANTS_GS").size() == 1

            // the canonical lowercase meta.variant_type is what reaches the
            // process tags, for both the primary and the GS lineage
            assert tasksNamed("GATK_SELECTVARIANTS").collect { name ->
                name.replaceAll(/^.*\(/, "").replaceAll(/\)$/, "")
            } as Set == ["cohort:snp", "cohort:indel"] as Set
            assert tasksNamed("GATK_VARIANTFILTRATION_GS").collect { name ->
                name.replaceAll(/^.*\(/, "").replaceAll(/\)$/, "")
            } == ["cohort_gs:snp"]

            // one gVCF per biological sample (Issue #12)
            assert path("$outputDir/variants/gvcf/sample_a.g.vcf.gz").exists()
            assert path("$outputDir/variants/gvcf/sample_a.g.vcf.gz.tbi").exists()
            assert path("$outputDir/variants/gvcf/sample_b.g.vcf.gz").exists()
            assert path("$outputDir/variants/gvcf/sample_b.g.vcf.gz.tbi").exists()

            // Issue #20 review (P1-2): the final genotype/AC/AN/AF
            // contract below is satisfied whether or not --sample-ploidy
            // is actually passed to HaplotypeCaller/GenotypeGVCFs (GATK
            // 4.6.2.0 was measured to infer the correct ploidy from its
            // GenomicsDB/gVCF input either way -- see the PR for the
            // comparison). So it cannot, by itself, prove the explicit
            // propagation added in this PR is actually wired up. Check
            // the real GATKCommandLine header each tool embeds in its
            // own output instead, which is unambiguous either way.
            def gvcf_a_lines = path("$outputDir/variants/gvcf/sample_a.g.vcf.gz").linesGzip
            def gvcf_a_commandline = gvcf_a_lines.find { line -> line.startsWith("##GATKCommandLine=<ID=HaplotypeCaller") }
            assert gvcf_a_commandline != null: "no HaplotypeCaller ##GATKCommandLine header found in sample_a gVCF"
            assert gvcf_a_commandline.contains("--sample-ploidy 2")

            // raw cohort VCF and index
            def raw_vcf = path("$outputDir/variants/raw/cohort.raw.vcf.gz")
            assert raw_vcf.exists()
            assert path("$outputDir/variants/raw/cohort.raw.vcf.gz.tbi").exists()

            def raw_lines = raw_vcf.linesGzip
            def header = raw_lines.find { line -> line.startsWith("#CHROM") }
            def data_lines = raw_lines.findAll { line -> !line.startsWith("#") }
            def headerColumns = header.split("\t")

            def raw_genotypegvcfs_commandline = raw_lines.find { line -> line.startsWith("##GATKCommandLine=<ID=GenotypeGVCFs") }
            assert raw_genotypegvcfs_commandline != null: "no GenotypeGVCFs ##GATKCommandLine header found in raw cohort VCF"
            assert raw_genotypegvcfs_commandline.contains("--sample-ploidy 2")

            // sample-column order and "no unexpected variant records"
            assert header == "#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\tsample_a\tsample_b"
            assert data_lines.size() == 2

            def parseInfo = { String infoField ->
                infoField.split(";").collectEntries { entry ->
                    def keyValue = entry.split("=", 2)
                    [(keyValue[0]): (keyValue.size() > 1 ? keyValue[1] : "true")]
                }
            }
            def parseSample = { String formatField, String sampleField ->
                [formatField.split(":"), sampleField.split(":")]
                    .transpose()
                    .collectEntries { it }
            }

            // tests/data/variants/expected_variants.tsv is the single
            // source of truth for the genotype/annotation contract:
            // it is generated alongside the fixture, and read here
            // directly rather than duplicated as literals, so the
            // contract and this test cannot drift apart. Every field
            // below -- including DP -- is asserted as an exact match
            // against this pinned GATK container's real output, not
            // a lower bound, so a depth regression (for example from
            // a duplicate-marking or mapping change) fails the test.
            def contractLines = file("${projectDir}/tests/data/variants/expected_variants.tsv")
                .readLines()
                .findAll { line -> !line.trim().isEmpty() }
            def contractHeader = contractLines[0].split("\t")
            def contract = contractLines.drop(1).collect { line ->
                [contractHeader, line.split("\t")].transpose().collectEntries { it }
            }
            assert contract.size() == 2

            contract.each { expected ->
                def record = data_lines
                    .find { line -> line.startsWith("${expected.contig}\t${expected.position}\t") }
                    ?.split("\t")
                assert record != null: "no raw VCF record found for ${expected.contig}:${expected.position}"

                assert record[3] == expected.ref
                assert record[4] == expected.alt

                def info = parseInfo(record[7])
                assert info["AC"] == expected.ac
                assert info["AN"] == expected.an
                assert info["AF"].toDouble() == expected.af.toDouble()
                assert info["DP"] == expected.site_dp

                def altColumn = headerColumns.findIndexOf { column -> column == expected.alt_sample_id }
                def refColumn = headerColumns.findIndexOf { column -> column == expected.ref_sample_id }
                def altSample = parseSample(record[8], record[altColumn])
                def refSample = parseSample(record[8], record[refColumn])

                assert altSample["GT"] == expected.alt_genotype
                assert altSample["DP"] == expected.alt_sample_dp
                assert refSample["GT"] == expected.ref_genotype
                assert refSample["DP"] == expected.ref_sample_dp
            }

            // Issue #8: decode the real merged, duplicate-marked BAM
            // headers/records directly (BGZF is valid concatenated-
            // member gzip, so java.util.zip.GZIPInputStream alone can
            // read it -- no samtools binary needed on the test runner)
            // rather than trusting the mapping/merge/dedup design intent.
            def parseBamHeaderText = { File bamFile ->
                def bytes = new java.util.zip.GZIPInputStream(new FileInputStream(bamFile)).bytes
                assert new String(bytes[0..2] as byte[]) == "BAM"
                assert bytes[3] == 1: "unexpected BAM magic byte 4: ${bytes[3]}"
                int lText = ((bytes[4] & 0xFF)) | ((bytes[5] & 0xFF) << 8) | ((bytes[6] & 0xFF) << 16) | ((bytes[7] & 0xFF) << 24)
                return new String(bytes[8..(8 + lText - 1)] as byte[])
            }
            def parseBamAlignmentStats = { File bamFile ->
                def bytes = new java.util.zip.GZIPInputStream(new FileInputStream(bamFile)).bytes
                int pos = 0
                def readInt32 = {
                    int v = ((bytes[pos] & 0xFF)) | ((bytes[pos + 1] & 0xFF) << 8) | ((bytes[pos + 2] & 0xFF) << 16) | ((bytes[pos + 3] & 0xFF) << 24)
                    pos += 4
                    return v
                }
                def readUInt16 = {
                    int v = ((bytes[pos] & 0xFF)) | ((bytes[pos + 1] & 0xFF) << 8)
                    pos += 2
                    return v
                }
                pos = 4
                int lText = readInt32()
                pos += lText
                int nRef = readInt32()
                (1..nRef).each {
                    int lName = readInt32()
                    pos += lName
                    readInt32()
                }
                int total = 0
                int duplicates = 0
                while (pos < bytes.length) {
                    int blockSize = readInt32()
                    int recordStart = pos
                    pos += 14
                    int flag = readUInt16()
                    if ((flag & 0x400) != 0) {
                        duplicates++
                    }
                    total++
                    pos = recordStart + blockSize
                }
                return [total: total, duplicates: duplicates]
            }

            def sampleABam = new File("$outputDir/alignment/sample_a.markdup.bam")
            def sampleBBam = new File("$outputDir/alignment/sample_b.markdup.bam")

            def sampleAHeaderLines = parseBamHeaderText(sampleABam).split("\n")
            assert sampleAHeaderLines.find { line -> line.startsWith("@HD") }?.contains("SO:coordinate")
            def sampleARgLines = sampleAHeaderLines.findAll { line -> line.startsWith("@RG") }
            assert sampleARgLines.size() == 2
            def sampleARgL001 = sampleARgLines.find { line -> line.contains("ID:sample_a_L001") }
            def sampleARgL002 = sampleARgLines.find { line -> line.contains("ID:sample_a_L002") }
            assert sampleARgL001 != null: "sample_a BAM is missing @RG ID:sample_a_L001"
            assert sampleARgL002 != null: "sample_a BAM is missing @RG ID:sample_a_L002"
            assert sampleARgL001.contains("SM:sample_a") && sampleARgL001.contains("LB:lib_a") &&
                sampleARgL001.contains("PL:ILLUMINA") && sampleARgL001.contains("PU:flowcell1.L001.ATCACG")
            assert sampleARgL002.contains("SM:sample_a") && sampleARgL002.contains("LB:lib_a") &&
                sampleARgL002.contains("PL:ILLUMINA") && sampleARgL002.contains("PU:flowcell1.L002.ATCACG")

            def sampleBHeaderLines = parseBamHeaderText(sampleBBam).split("\n")
            assert sampleBHeaderLines.find { line -> line.startsWith("@HD") }?.contains("SO:coordinate")
            def sampleBRgLines = sampleBHeaderLines.findAll { line -> line.startsWith("@RG") }
            assert sampleBRgLines.size() == 1
            assert sampleBRgLines[0].contains("ID:sample_b_L001") && sampleBRgLines[0].contains("SM:sample_b") &&
                sampleBRgLines[0].contains("LB:lib_b") && sampleBRgLines[0].contains("PL:ILLUMINA") &&
                sampleBRgLines[0].contains("PU:flowcell1.L001.CGATGT")

            def sampleAStats = parseBamAlignmentStats(sampleABam)
            assert sampleAStats.total == 40
            assert sampleAStats.duplicates == 4

            def sampleBStats = parseBamAlignmentStats(sampleBBam)
            assert sampleBStats.total == 24
            assert sampleBStats.duplicates == 0

            def sampleAMetrics = path("$outputDir/qc/markduplicates/sample_a.markduplicates.metrics.txt")
            def sampleBMetrics = path("$outputDir/qc/markduplicates/sample_b.markduplicates.metrics.txt")
            assert sampleAMetrics.exists()
            assert sampleBMetrics.exists()

            // Issue #38: the cohort-level MultiQC process scans only the
            // seven explicitly collected QC-report categories. Assert the
            // stable semantic subset of MultiQC 1.35's JSON, not the HTML
            // bytes or runtime-generated timestamps.
            def multiqcDir = new File("$outputDir/qc/multiqc")
            def multiqcReport = new File(multiqcDir, "multiqc_report.html")
            def multiqcDataDir = new File(multiqcDir, "multiqc_data")
            def multiqcJsonFile = new File(multiqcDataDir, "multiqc_data.json")
            def multiqcConfig = new File(multiqcDir, "multiqc_config.yaml")
            def multiqcVersion = new File(multiqcDir, "multiqc_version.txt")

            assert multiqcReport.exists() && multiqcReport.length() > 0
            assert multiqcReport.text.toLowerCase().contains("<!doctype html>")
            assert multiqcDataDir.isDirectory()
            assert multiqcJsonFile.exists() && multiqcJsonFile.length() > 0
            assert multiqcConfig.bytes == file("${projectDir}/conf/multiqc_config.yaml").bytes
            assert multiqcVersion.text.contains("1.35")

            def multiqc = new groovy.json.JsonSlurper().parse(multiqcJsonFile)
            def parsed = multiqc.report_saved_raw_data
            def expectedReadGroups = [
                "sample_a_L001",
                "sample_a_L002",
                "sample_b_L001",
            ] as Set
            def expectedFastqcSamples = expectedReadGroups.collectMany { readGroup ->
                [
                    "${readGroup}.raw.R1",
                    "${readGroup}.raw.R2",
                    "${readGroup}.trimmed.R1",
                    "${readGroup}.trimmed.R2",
                ]
            } as Set

            assert parsed.multiqc_fastqc.keySet() as Set == expectedFastqcSamples
            assert parsed.multiqc_fastp.keySet() as Set == expectedReadGroups
            assert parsed.multiqc_picard_dups.keySet() as Set == ["sample_a", "sample_b"] as Set
            assert parsed.multiqc_samtools_flagstat.keySet() as Set == ["sample_a", "sample_b"] as Set
            assert parsed.multiqc_samtools_stats.keySet() as Set == ["sample_a", "sample_b"] as Set
            assert parsed.multiqc_samtools_idxstats.keySet() as Set == ["sample_a", "sample_b"] as Set

            def sources = multiqc.report_data_sources
            assert sources.Picard.DuplicationMetrics.size() == 2
            assert sources.Samtools.flagstat.size() == 2
            assert sources.Samtools.stats.size() == 2
            assert sources.Samtools.idxstats.size() == 2
            assert sources.fastp.all_sections.size() == 3
            assert sources.FastQC.all_sections.size() == 12
            assert [
                sources.Picard.DuplicationMetrics,
                sources.Samtools.flagstat,
                sources.Samtools.stats,
                sources.Samtools.idxstats,
                sources.fastp.all_sections,
                sources.FastQC.all_sections,
            ].sum { sourceClass -> sourceClass.size() } == 23

            def provenanceText = new File(multiqcDataDir, "multiqc_sources.json").text
            def multiqcLogText = new File(multiqcDataDir, "multiqc.log").text
            [
                projectDir.toString(),
                new File("$outputDir").getParentFile().absolutePath,
                "/work/",
                "/tmp/",
            ].each { forbiddenPath ->
                assert !multiqcJsonFile.text.contains(forbiddenPath)
                assert !provenanceText.contains(forbiddenPath)
                assert !multiqcLogText.contains(forbiddenPath)
            }

            def sourcePaths = [
                sources.Picard.DuplicationMetrics,
                sources.Samtools.flagstat,
                sources.Samtools.stats,
                sources.Samtools.idxstats,
                sources.fastp.all_sections,
                sources.FastQC.all_sections,
            ].collectMany { sourceClass -> sourceClass.values() }
            assert sourcePaths.every { sourcePath -> sourcePath.startsWith("/multiqc/input/") }
            assert sourcePaths.every { sourcePath ->
                !sourcePath.endsWith(".html") &&
                !sourcePath.endsWith(".vcf") &&
                !sourcePath.endsWith(".vcf.gz") &&
                !sourcePath.endsWith(".bam") &&
                !sourcePath.endsWith(".fastq.gz")
            }

            // optical_duplicate_pixel_distance actually reaches the real
            // GATK command line (Picard records its own full invocation
            // as a comment header in the metrics file)
            assert sampleAMetrics.text.contains("--OPTICAL_DUPLICATE_PIXEL_DISTANCE 2500")
            assert sampleBMetrics.text.contains("--OPTICAL_DUPLICATE_PIXEL_DISTANCE 2500")

            // PR #14 filtering/QC regression guard: both synthetic
            // SNPs still fail the default SOR threshold, and indels
            // remain empty (this fixture does not encode any)
            def filteredData = path("$outputDir/variants/filtered/cohort.snp.filtered.vcf.gz")
                .linesGzip
                .findAll { line -> !line.startsWith("#") }
            assert filteredData.size() == 2
            assert filteredData.every { line -> line.split("\t")[6] == "SNP_SOR_HIGH" }

            def passData = path("$outputDir/variants/pass/cohort.snp.pass.vcf.gz")
                .linesGzip
                .findAll { line -> !line.startsWith("#") }
            assert passData.size() == 0

            def indelData = path("$outputDir/variants/by_type/cohort.indel.vcf.gz")
                .linesGzip
                .findAll { line -> !line.startsWith("#") }
            assert indelData.size() == 0

            // Issue #16: bin/summarize_variant_qc.py replaced the
            // embedded AWK in BCFTOOLS_STATS. Assert its wiring
            // end to end: 7 stage/type combinations x 4 files each,
            // and the exact metric values the genotype contract above
            // implies (0 missing genotypes for the raw cohort, "NA"
            // missingness where 0 records exist). 36 files from Issues
            // #12/#15/#16, plus 2 more from Issue #18's
            // classify_normalized_variants.py accounting (cohort_gs.
            // classification_accounting.tsv/.summary.txt), which is
            // published alongside the other variant-QC accounting
            // files since it is the same kind of artifact.
            def qcFiles = new File("$outputDir/qc/variants").listFiles()
            assert qcFiles.size() == 38

            def rawAllVariantQc = path("$outputDir/qc/variants/cohort.raw.all.variant_qc.tsv")
                .readLines()
                .collectEntries { line ->
                    def fields = line.split("\t")
                    [(fields[3]): fields[4]]
                }
            assert rawAllVariantQc["number_of_samples"] == "2"
            assert rawAllVariantQc["cohort_missing_genotypes"] == "0"
            assert rawAllVariantQc["cohort_total_genotypes"] == "4"
            assert rawAllVariantQc["cohort_missingness_rate"] == "0.000000"
            assert rawAllVariantQc["sample_names"] == "sample_a,sample_b"

            def rawAllSampleQcLines = path("$outputDir/qc/variants/cohort.raw.all.sample_qc.tsv").readLines()
            assert rawAllSampleQcLines.size() == 3
            assert rawAllSampleQcLines[1].split("\t")[7] == "0"
            assert rawAllSampleQcLines[1].split("\t")[8] == "0.000000"
            assert rawAllSampleQcLines[2].split("\t")[7] == "0"
            assert rawAllSampleQcLines[2].split("\t")[8] == "0.000000"

            // default filtering excludes both SNPs (SNP_SOR_HIGH), so
            // the pass/snp stage has 0 records and must report "NA"
            // missingness rather than a division-by-zero crash or 0
            def passSnpSampleQc = path("$outputDir/qc/variants/cohort.pass.snp.sample_qc.tsv").readLines()
            assert passSnpSampleQc.drop(1).every { line -> line.split("\t")[8] == "NA" }

            // Issue #15: bin/summarize_filter_qc.py adds FILTER-value
            // breakdown and per-annotation coverage for the filtered
            // stage. Both synthetic SNPs fail only SNP_SOR_HIGH, so
            // assert the breakdown reflects exactly that combination,
            // and that MQRankSum/ReadPosRankSum -- absent from GATK's
            // INFO output for this fixture -- are reported as
            // "not evaluated" (evaluable_rate 0, filter_hit_rate NA)
            // rather than silently read as "passed".
            def filteredSnpBreakdown = path("$outputDir/qc/variants/cohort.filtered.snp.filter_breakdown.tsv")
                .readLines()
                .drop(1)
                .collectEntries { line ->
                    def fields = line.split("\t")
                    [("${fields[3]}:${fields[4]}".toString()): fields[5]]
                }
            assert filteredSnpBreakdown["summary:total_records"] == "2"
            assert filteredSnpBreakdown["summary:pass_records"] == "0"
            assert filteredSnpBreakdown["summary:non_pass_records"] == "2"
            assert filteredSnpBreakdown["summary:multi_tag_records"] == "0"
            assert filteredSnpBreakdown["summary:distinct_filter_combinations"] == "1"
            assert filteredSnpBreakdown["summary:distinct_filter_tags"] == "1"
            assert filteredSnpBreakdown["combination:SNP_SOR_HIGH"] == "2"
            assert filteredSnpBreakdown["tag:SNP_SOR_HIGH"] == "2"

            def filteredIndelBreakdown = path("$outputDir/qc/variants/cohort.filtered.indel.filter_breakdown.tsv")
                .readLines()
                .drop(1)
                .collectEntries { line ->
                    def fields = line.split("\t")
                    [("${fields[3]}:${fields[4]}".toString()): fields[5]]
                }
            assert filteredIndelBreakdown["summary:total_records"] == "0"
            assert filteredIndelBreakdown["summary:pass_records"] == "0"
            assert filteredIndelBreakdown["summary:non_pass_records"] == "0"

            def filteredSnpAnnotationQc = path("$outputDir/qc/variants/cohort.filtered.snp.annotation_qc.tsv")
                .readLines()
                .drop(1)
                .collectEntries { line ->
                    def fields = line.split("\t")
                    [(fields[3]): fields]
                }
            assert filteredSnpAnnotationQc["MQRankSum"][5] == "0"
            assert filteredSnpAnnotationQc["MQRankSum"][7] == "0.000000"
            assert filteredSnpAnnotationQc["MQRankSum"][10] == "NA"
            assert filteredSnpAnnotationQc["ReadPosRankSum"][5] == "0"
            assert filteredSnpAnnotationQc["ReadPosRankSum"][7] == "0.000000"
            assert filteredSnpAnnotationQc["ReadPosRankSum"][10] == "NA"
            assert filteredSnpAnnotationQc["SOR"][5] == "2"
            assert filteredSnpAnnotationQc["SOR"][9] == "2"
            assert filteredSnpAnnotationQc["SOR"][10] == "1.000000"

            // Issue #15: bin/reconcile_variant_type_counts.py cross-checks
            // raw/all against the raw/snp + raw/indel split. This fixture
            // has no MIXED/MNP/other records, so the split must reconcile
            // cleanly (records_not_selected == 0, no duplicate records).
            def variantTypeAccounting = path("$outputDir/qc/variants/cohort.variant_type_accounting.tsv")
                .readLines()
                .drop(1)
                .collectEntries { line ->
                    def fields = line.split("\t")
                    [(fields[1]): fields[2]]
                }
            assert variantTypeAccounting["raw_all_records"] == "2"
            assert variantTypeAccounting["raw_snp_records"] == "2"
            assert variantTypeAccounting["raw_indel_records"] == "0"
            assert variantTypeAccounting["records_not_selected"] == "0"
            assert variantTypeAccounting["records_not_selected_is_negative"] == "false"
            assert variantTypeAccounting["snp_indel_duplicate_records"] == "0"

            def gsClassificationAccounting = path("$outputDir/qc/variants/cohort_gs.classification_accounting.tsv")
                .readLines()
                .collectEntries { line ->
                    def fields = line.split("\t")
                    [(fields[1]): fields[2]]
                }
            assert gsClassificationAccounting["total_input_records"] == "2"
            assert gsClassificationAccounting["snp_records"] == "2"
            assert gsClassificationAccounting["mnp_records"] == "0"
            assert gsClassificationAccounting["indel_records"] == "0"
            assert gsClassificationAccounting["symbolic_or_star_records"] == "0"
            assert gsClassificationAccounting["no_alt_records"] == "0"
            assert gsClassificationAccounting["duplicate_key_records"] == "0"
            assert gsClassificationAccounting["output_records"] == "2"

            // Issue #18: the GS panel lineage re-evaluates the same two
            // synthetic SNPs (normalized from raw/all, since that is
            // the only stage that can still carry a MIXED record) under
            // the same SNP hard filters. Both already fail
            // SNP_SOR_HIGH in the primary lineage above, so the GS
            // lineage's PASS VCF -- and therefore the panel itself --
            // must end up empty too. This is the exact "empty PASS SNP
            // VCF" contract Issue #18 requires be exercised against the
            // pipeline's real default fixture, not just a hand-crafted
            // unit-test fixture.
            def gsPassData = path("$outputDir/variants/gs_pass/cohort_gs.snp.pass.vcf.gz")
                .linesGzip
                .findAll { line -> !line.startsWith("#") }
            assert gsPassData.size() == 0

            def gsPanelFiles = new File("$outputDir/gs_panel").listFiles()
            assert gsPanelFiles.size() == 8

            def matrixLines = path("$outputDir/gs_panel/cohort.gs_panel.genotype_matrix.tsv.gz")
                .linesGzip
            assert matrixLines.size() == 1
            assert matrixLines[0] == "variant_key\tsample_a\tsample_b"

            def gsSampleMetadata = path("$outputDir/gs_panel/cohort.gs_panel.sample_metadata.tsv")
                .readLines()
            assert gsSampleMetadata.size() == 3
            assert gsSampleMetadata.drop(1).every { line -> line.split("\t")[4] == "NA" }
            assert gsSampleMetadata[1].split("\t")[2] == "sample_a"
            assert gsSampleMetadata[2].split("\t")[2] == "sample_b"

            def gsVariantMetadata = path("$outputDir/gs_panel/cohort.gs_panel.variant_metadata.tsv")
                .readLines()
            assert gsVariantMetadata.size() == 1

            def gsRecordAccounting = path("$outputDir/gs_panel/cohort.gs_panel.record_accounting.tsv")
                .readLines()
                .collectEntries { line ->
                    def fields = line.split("\t")
                    [(fields[1]): fields[2]]
                }
            assert gsRecordAccounting["raw_all_records"] == "2"
            assert gsRecordAccounting["normalized_records"] == "2"
            assert gsRecordAccounting["classified_biallelic_snp_records"] == "2"
            assert gsRecordAccounting["gs_hard_filter_excluded_records"] == "2"
            assert gsRecordAccounting["gs_pass_records"] == "0"
            assert gsRecordAccounting["gs_pass_sample_count"] == "2"
            // Issue #18 PR review (P1-3): these are read directly from
            // the matrix and metadata files themselves, not derived
            // from each other, and reconcile_gs_panel_accounting.py
            // would have exited 1 (no output written at all) had any
            // of them disagreed -- so their mutual agreement here is a
            // property this file's mere existence already guarantees.
            assert gsRecordAccounting["matrix_variant_records"] == "0"
            assert gsRecordAccounting["matrix_sample_count"] == "2"
            assert gsRecordAccounting["variant_metadata_records"] == "0"
            assert gsRecordAccounting["sample_metadata_records"] == "2"
            assert gsRecordAccounting["panel_status"] == "empty"

            def manifestJson = new groovy.json.JsonSlurper().parse(
                new File("$outputDir/gs_panel/cohort.gs_panel.manifest.json")
            )
            assert manifestJson.schema_version == 2
            assert manifestJson.panel_status == "empty"
            assert manifestJson.cohort_id == "cohort"
            assert manifestJson.parameters.sample_ploidy == 2
            assert manifestJson.genotype_encoding.ploidy == "diploid_only"
            assert manifestJson.genotype_encoding.missing_token == "nan"
            // gs_pass_vcf, matrix, sample_metadata, variant_metadata,
            // genotype_accounting(+summary), record_accounting(+summary),
            // raw_all_vcf, reference_fasta, reference_fai (Issue #18 PR
            // review, P1-4: provenance, not just self-consistency).
            assert manifestJson.checksums.size() == 11

            // Issue #52: schema v2 records one effective container per
            // GS-lineage process (never merged by shared tool), each read
            // from that process's own task.container. With no override
            // configured in this test, every entry must equal the single
            // default-value source of truth in conf/containers.config --
            // proving the wiring in workflows/adzuki_snp_pipeline.nf
            // actually reaches every one of the eight processes the GS
            // lineage runs, not just whichever ones happened to be
            // non-empty before. The expected values are parsed out of
            // conf/containers.config itself (tests/lib/GsContainerDefaults.groovy),
            // never copied into this file: a copied digest would still pass
            // against a pipeline that had gone back to hardcoding the same
            // value in every module -- exactly the state Issue #52 exists
            // to leave behind -- and would need a hand edit on every
            // legitimate image bump.
            def containerDefaults = GsContainerDefaults.read(projectDir)
            def expectedContainers = [
                gs_normalize_variants        : containerDefaults.bcftools,
                classify_normalized_variants : containerDefaults.python,
                gs_index_classified_variants : containerDefaults.bcftools,
                gatk_variantfiltration_gs    : containerDefaults.gatk,
                gatk_selectpassvariants_gs   : containerDefaults.gatk,
                build_gs_panel               : containerDefaults.python,
                reconcile_gs_panel_accounting: containerDefaults.python,
                // The manifest-writing process records itself too, so the
                // one identity a reader needs to reproduce the manifest
                // itself is not the one entry missing from it.
                build_gs_panel_manifest      : containerDefaults.python,
            ]
            assert manifestJson.containers.size() == 8
            assert manifestJson.containers.keySet() == expectedContainers.keySet()
            expectedContainers.each { processName, expectedReference ->
                assert manifestJson.containers[processName] == expectedReference:
                    "manifest recorded ${manifestJson.containers[processName]} for ${processName}, expected ${expectedReference}"
            }

            // ...and each recorded identity is the container that task
            // really ran in, not merely the value the workflow passed
            // along: every GS task's own `.command.run` (whose
            // nxf_launch() embeds the literal `docker run ... <image>`
            // Nextflow used) must name the same image recorded for it.
            GS_TASK_NEEDLES.each { processName, needle ->
                def runs = findCommandRunScripts(outputDir.toString(), needle)
                assert runs.size() == 1:
                    "expected exactly one ${processName} task for needle '${needle}', found ${runs.size()}"
                assert runs[0].contains(expectedContainers[processName]):
                    "${processName} did not run in ${expectedContainers[processName]}"
            }

            // ---------------------------------------------------------
            // Issue #42: the run-level provenance manifest.
            //
            // A successful run publishes it on its own, at a stable
            // path, with no manual post-run CLI step. Everything below
            // checks it against something independent -- the fixture
            // bytes on disk, the QC artifacts the pipeline published, or
            // the image Nextflow actually launched each task with --
            // rather than against values copied out of the manifest.
            // ---------------------------------------------------------
            def runManifest = readRunManifest(outputDir.toString())

            assert runManifest.schema_version == 2
            assert runManifest.cohort_id == "cohort"

            // The pipeline version is read from nextflow.config's own
            // manifest block rather than copied here, so bumping the
            // release version needs no test edit. (nf-test's `workflow`
            // object is its own WorkflowMeta and does not expose
            // Nextflow's `workflow.manifest`.)
            def declaredPipelineVersion = (
                new File("${projectDir}/nextflow.config").text
                    =~ /(?m)^\s*version\s*=\s*'([^']+)'/
            )[0][1]
            assert runManifest.pipeline_version == declaredPipelineVersion

            // A full 40-character SHA, not an abbreviation and not null:
            // workflow.commitId is null for a local `nextflow run .`, so
            // this also proves main.nf's explicit resolution ran.
            assert runManifest.git_commit ==~ /^[0-9a-f]{40}\z/

            // The engine's own version, which has previously been the
            // root cause of a real failure in this pipeline (Issue #11).
            // Checked by shape, and against the minimum this repository
            // declares it needs, rather than pinned to a literal: the
            // engine version is pinned in .github/workflows/test.yml, and
            // duplicating it here would turn an engine upgrade into a
            // test edit. What matters for provenance is that a real
            // runtime version was recorded, not a placeholder.
            assert runManifest.nextflow_version ==~ /^\d+\.\d+\.\d+\z/

            def declaredMinimumNextflow = (
                new File("${projectDir}/nextflow.config").text
                    =~ /(?m)^\s*nextflowVersion\s*=\s*'>=([0-9.]+)'/
            )[0][1]
            // Zero-padded per component so a plain string comparison
            // orders versions numerically (10 after 9, not before it).
            def comparableVersion = { String version ->
                version.split(/\./).collect { part -> part.padLeft(6, '0') }.join('.')
            }
            assert comparableVersion(runManifest.nextflow_version) >=
                comparableVersion(declaredMinimumNextflow):
                "recorded Nextflow version ${runManifest.nextflow_version} is below " +
                "this pipeline's declared minimum ${declaredMinimumNextflow}"

            assert runManifest.manifest_hash.startsWith("sha256:")

            // Material parameters, with their real types.
            assert runManifest.parameters.sample_ploidy == 2
            assert runManifest.parameters.enable_gs_panel == true
            assert runManifest.parameters.genomicsdb_batch_size == 50
            // This run overrides optical_duplicate_pixel_distance to a
            // non-default 2500 (see the params block above), and passes
            // it as the String a real CLI invocation would produce. The
            // manifest must record the value this run actually used, as
            // a number -- not the pipeline default, and not "2500".
            assert runManifest.parameters.optical_duplicate_pixel_distance == 2500
            assert runManifest.parameters.snp_filter_qd_min == 2.0
            assert runManifest.parameters.snp_filter_qual_min == 30.0
            assert runManifest.parameters.indel_filter_fs_max == 200.0
            assert runManifest.parameters.indel_filter_read_pos_rank_sum_min == -20.0

            // Reference identity, and every reference file the run
            // actually consumed -- checksums compared against this test's
            // own hash of the fixture, not against the manifest itself.
            assert runManifest.reference.reference_id == "synthetic-adzuki-v1"
            assert runManifest.reference.reference_name == "Synthetic adzuki test reference"
            assert runManifest.reference.reference_species == "Vigna angularis"
            assert runManifest.reference.fasta.filename == "synthetic.fa"
            assert runManifest.reference.fasta.checksum ==
                sha256Of("${projectDir}/tests/data/reference/synthetic.fa")
            assert runManifest.reference.fai.filename == "synthetic.fa.fai"
            assert runManifest.reference.fai.checksum ==
                sha256Of("${projectDir}/tests/data/reference/synthetic.fa.fai")
            assert runManifest.reference.dict.filename == "synthetic.dict"
            assert runManifest.reference.dict.checksum ==
                sha256Of("$outputDir/reference/synthetic.dict")

            // The BWA-MEM2 index this run generated and mapped against.
            assert runManifest.reference.bwa_index.collect { entry -> entry.filename } == [
                "synthetic.fa.0123",
                "synthetic.fa.amb",
                "synthetic.fa.ann",
                "synthetic.fa.bwt.2bit.64",
                "synthetic.fa.pac",
            ]
            runManifest.reference.bwa_index.each { entry ->
                assert entry.checksum == sha256Of("$outputDir/reference/${entry.filename}"):
                    "reference index ${entry.filename} checksum does not match the file the run produced"
            }

            // Input FASTQ provenance, in samplesheet order, by basename,
            // with checksums of the real fixture reads.
            assert runManifest.samples.collect { entry -> entry.read_group_id } == [
                "sample_a_L001",
                "sample_a_L002",
                "sample_b_L001",
            ]
            assert runManifest.samples[0].sample_id == "sample_a"
            assert runManifest.samples[0].library_id == "lib_a"
            assert runManifest.samples[0].platform == "ILLUMINA"
            assert runManifest.samples[0].platform_unit == "flowcell1.L001.ATCACG"
            runManifest.samples.each { entry ->
                assert entry.fastq_1.checksum ==
                    sha256Of("${projectDir}/tests/data/reads/${entry.fastq_1.filename}")
                assert entry.fastq_2.checksum ==
                    sha256Of("${projectDir}/tests/data/reads/${entry.fastq_2.filename}")
            }

            // Output checksums: the artifact set the historical schema v1
            // manifests recorded, hashed from what this run produced.
            assert runManifest.checksums.keySet() == [
                "sample_a.g.vcf.gz",
                "sample_b.g.vcf.gz",
                "cohort.raw.vcf.gz",
                "cohort.snp.pass.vcf.gz",
                "cohort.indel.pass.vcf.gz",
            ] as Set
            assert runManifest.checksums["cohort.raw.vcf.gz"] ==
                sha256Of("$outputDir/variants/raw/cohort.raw.vcf.gz")
            assert runManifest.checksums["sample_a.g.vcf.gz"] ==
                sha256Of("$outputDir/variants/gvcf/sample_a.g.vcf.gz")

            // Accounting is the QC the pipeline already published, not a
            // second computation of the same numbers.
            assert runManifest.cohort_accounting.number_of_samples == "2"
            assert runManifest.cohort_accounting.sample_names == "sample_a,sample_b"
            assert runManifest.sample_accounting.collect { row -> row.sample } ==
                ["sample_a", "sample_b"]
            assert runManifest.sample_accounting[0].keySet() == [
                "sample",
                "reference_homozygous",
                "non_reference_homozygous",
                "heterozygous",
                "missing",
                "missingness_rate",
                "average_depth",
                "singletons",
            ] as Set
            assert runManifest.variant_type_accounting.raw_all_records == "2"
            assert runManifest.variant_type_accounting.raw_snp_records == "2"
            assert runManifest.variant_type_accounting.raw_indel_records == "0"

            // With the GS panel enabled the run manifest points at the GS
            // manifest this same run produced, by its own hash.
            assert runManifest.gs_panel != null
            assert runManifest.gs_panel.cohort_id == "cohort"
            assert runManifest.gs_panel.schema_version == manifestJson.schema_version
            assert runManifest.gs_panel.run_id == manifestJson.run_id
            assert runManifest.gs_panel.panel_status == manifestJson.panel_status
            assert runManifest.gs_panel.manifest_hash == manifestJson.manifest_hash

            // Every process key the manifest records must be one this run
            // actually executed, and must name the image Nextflow really
            // launched that process with -- compared against each task's
            // own `.command.run`, not against the manifest itself.
            (RUN_TASK_NEEDLES + OPTIONAL_REFERENCE_TASK_NEEDLES).each { processName, needle ->
                assert runManifest.containers.containsKey(processName):
                    "run manifest has no container entry for executed process ${processName}"

                def runs = findCommandRunScripts(outputDir.toString(), needle)
                assert runs.size() >= 1:
                    "expected at least one ${processName} task for needle '${needle}'"
                assert runs.every { run -> run.contains(runManifest.containers[processName]) }:
                    "a ${processName} task did not run in ${runManifest.containers[processName]}"
            }

            // The GS lineage's own eight keys, checked the same way
            // against the GS manifest's own recorded identities.
            expectedContainers.each { processName, expectedReference ->
                assert runManifest.containers[processName] == expectedReference:
                    "run manifest and GS manifest disagree about ${processName}"
            }

            // Terminal barrier: MULTIQC is a side branch that produces
            // nothing the manifest's content depends on, so it would be
            // free to still be running when the manifest was written --
            // unless the manifest depends on its container identity, as
            // it does. Its presence here is what makes "the run manifest
            // is the last thing that happens" true rather than hoped for.
            assert runManifest.containers.containsKey("multiqc")

            // Aliases of one module stay distinct identities.
            assert runManifest.containers.containsKey("fastqc_raw")
            assert runManifest.containers.containsKey("fastqc_trimmed")
            assert runManifest.containers.containsKey("gatk_variantfiltration")
            assert runManifest.containers.containsKey("gatk_variantfiltration_gs")
            assert runManifest.containers.containsKey("gatk_selectpassvariants")
            assert runManifest.containers.containsKey("gatk_selectpassvariants_gs")

            // Every executed process, and nothing else -- compared
            // against Nextflow's own trace of what ran, so a process
            // added later without being wired into the provenance
            // channel fails here instead of being silently omitted.
            assert runManifest.containers.keySet() ==
                executedProcessKeys(workflow.trace.tasks().collect { task -> task.name }):
                "run manifest containers do not match the processes Nextflow executed"

            // The hand-checked keys above are a subset of that, so the
            // two agree by construction; assert it rather than assume it.
            def individuallyCheckedKeys = (
                RUN_TASK_NEEDLES.keySet()
                + OPTIONAL_REFERENCE_TASK_NEEDLES.keySet()
                + expectedContainers.keySet()
            ) as Set
            assert runManifest.containers.keySet().containsAll(individuallyCheckedKeys)

            // Privacy: no host path, no file:// URI, no credential, and
            // nothing naming where this run happened.
            def serializedRunManifest =
                new File("$outputDir/provenance/cohort.run_manifest.json").text
            assert !serializedRunManifest.contains(projectDir.toString())
            assert !serializedRunManifest.contains(outputDir.toString())
            assert !serializedRunManifest.contains("file://")
            assert !serializedRunManifest.contains(System.getProperty("user.home"))
            assert !serializedRunManifest.contains(System.getProperty("user.name"))
            assert !serializedRunManifest.contains("workDir")
            assert !serializedRunManifest.contains("launchDir")
        }
    }

    // Issue #52 acceptance test: `conf/containers.config` is the single
    // source of truth for GS-lineage default containers, which means
    // changing a value *there and nowhere else* must change both what the
    // pipeline actually runs and what the manifest records -- the two can
    // then never drift apart, because they are the same fact read twice.
    //
    // This test changes it from a config alone (no module edit, no
    // workflow edit, no literal added anywhere) and follows the value
    // through the whole chain:
    //
    //     conf/containers.config's value, transformed by the fixture
    //       -> the image each GS task's real `docker run` used (.command.run)
    //       -> the identity recorded in cohort.gs_panel.manifest.json
    //
    // Asserting only the last link would leave the first unproven: a
    // manifest can be made to echo any value handed to it. Asserting only
    // the first would prove the run changed while saying nothing about
    // whether the provenance record noticed.
    //
    // The same run also keeps one process (GS_INDEX_CLASSIFIED_VARIANTS)
    // pinned to the *original* reference through its own `withName`
    // selector, so a changed default and a process-specific override can
    // be told apart for two processes that share a tool: bcftools' two GS
    // processes must come out on different containers, which is precisely
    // what schema v1's single `containers.bcftools` key could not express.
    test("changing only conf/containers.config's default reaches both the real container and the manifest, while a process-specific override still wins") {

        // Runnable on its own with `nf-test test --tag issue52_containers`,
        // so the Issue #52 container-provenance regressions can be checked
        // without a full-suite run.
        tag "issue52_containers"

        config "./fixtures/gs_container_default_change.config"

        when {
            params {
                // See the first test in this file for why the
                // samplesheet's paths are rewritten to absolute paths.
                def sourceLines = file("${projectDir}/tests/data/samplesheet.csv").readLines()
                def rewrittenLines = sourceLines.collect { line ->
                    line.replaceAll(
                        "tests/data/reads/",
                        "${projectDir}/tests/data/reads/"
                    )
                }
                def absoluteSamplesheet = new File("${outputDir}/samplesheet.absolute.csv")
                absoluteSamplesheet.text = rewrittenLines.join("\n") + "\n"

                outdir = "$outputDir"
                input = absoluteSamplesheet.toString()
                sample_ploidy = "2"
            }
        }

        then {
            assert workflow.success

            def manifestJson = new groovy.json.JsonSlurper().parse(
                new File("$outputDir/gs_panel/cohort.gs_panel.manifest.json")
            )
            assert manifestJson.schema_version == 2

            // The fixture rewrites every default to the same image
            // referenced by digest alone; this is the identical
            // transformation, so nothing here is a copy of a pinned
            // production digest.
            def containerDefaults = GsContainerDefaults.read(projectDir)
            def changedBcftools = GsContainerDefaults.digestOnly(containerDefaults.bcftools)
            def changedGatk = GsContainerDefaults.digestOnly(containerDefaults.gatk)
            def changedPython = GsContainerDefaults.digestOnly(containerDefaults.python)

            // Without this, an accidentally identity-shaped transform
            // would make every assertion below pass while proving nothing.
            assert changedBcftools != containerDefaults.bcftools
            assert changedGatk != containerDefaults.gatk
            assert changedPython != containerDefaults.python

            def expectedContainers = [
                gs_normalize_variants        : changedBcftools,
                classify_normalized_variants : changedPython,
                // Pinned back to the original by its own withName
                // selector: a process-specific override outranks the
                // changed default, and is recorded as such.
                gs_index_classified_variants : containerDefaults.bcftools,
                gatk_variantfiltration_gs    : changedGatk,
                gatk_selectpassvariants_gs   : changedGatk,
                build_gs_panel               : changedPython,
                reconcile_gs_panel_accounting: changedPython,
                build_gs_panel_manifest      : changedPython,
            ]

            assert manifestJson.containers.size() == 8
            expectedContainers.each { processName, expectedReference ->
                assert manifestJson.containers[processName] == expectedReference:
                    "manifest recorded ${manifestJson.containers[processName]} for ${processName}, expected ${expectedReference}"
            }

            // Two processes, one tool, two different effective containers
            // -- recorded separately rather than collapsed into one value.
            assert manifestJson.containers.gs_normalize_variants !=
                manifestJson.containers.gs_index_classified_variants

            // And the recorded values are what actually ran: each GS
            // task's own `.command.run` embeds the literal `docker run
            // ... <image>` Nextflow launched it with.
            GS_TASK_NEEDLES.each { processName, needle ->
                def runs = findCommandRunScripts(outputDir.toString(), needle)
                assert runs.size() == 1:
                    "expected exactly one ${processName} task for needle '${needle}', found ${runs.size()}"
                assert runs[0].contains(expectedContainers[processName]):
                    "${processName} did not run in ${expectedContainers[processName]}"
            }

            // The digest-only and tag-plus-digest forms are not substrings
            // of one another, so these two also prove each bcftools
            // process ran in *only* its own image -- the changed default
            // did not reach the overridden process, and the override did
            // not reach the defaulted one.
            def normalizeRuns = findCommandRunScripts(outputDir.toString(), GS_TASK_NEEDLES.gs_normalize_variants)
            def indexRuns = findCommandRunScripts(outputDir.toString(), GS_TASK_NEEDLES.gs_index_classified_variants)
            assert !normalizeRuns[0].contains(containerDefaults.bcftools)
            assert !indexRuns[0].contains(changedBcftools)
        }
    }

    // Issue #52 regression: proves the GS panel manifest records what a
    // task actually ran in, not module-file/workflow-literal defaults.
    // One pipeline run exercises three override mechanisms at once:
    //   - a plain `withName` override on GS_NORMALIZE_VARIANTS (a process
    //     with no non-GS alias), proving a simple override reaches the
    //     manifest at all;
    //   - a fully-qualified `withName` override
    //     (`ADZUKI_SNP_PIPELINE:GATK_VARIANTFILTRATION_GS`) on only the GS
    //     alias of the GATK_VARIANTFILTRATION module, while its sibling
    //     alias GATK_VARIANTFILTRATION (used by the primary, non-GS
    //     lineage) is left at its default -- proving a fully-qualified
    //     selector is captured and that the two aliases are never
    //     conflated into a single recorded value.
    // Both overrides swap in the *same underlying image*, referenced by
    // digest alone with its tag dropped, purely so the string differs
    // from the default: this keeps the run itself fast and deterministic
    // (no new image to pull, and no dependence on a mutable tag) while
    // still being a value regression guard -- a manifest that still
    // showed the unmodified default here would prove the override never
    // reached the manifest at all. Changing the default itself is the
    // separate acceptance test above.
    test("container overrides on GS_NORMALIZE_VARIANTS and the GATK_VARIANTFILTRATION_GS alias are recorded in the GS panel manifest, not their module defaults") {

        tag "issue52_containers"
        tag "issue42_run_manifest"

        config "./fixtures/gs_container_identity_override.config"

        when {
            params {
                def sourceLines = file("${projectDir}/tests/data/samplesheet.csv").readLines()
                def rewrittenLines = sourceLines.collect { line ->
                    line.replaceAll(
                        "tests/data/reads/",
                        "${projectDir}/tests/data/reads/"
                    )
                }
                def absoluteSamplesheet = new File("${outputDir}/samplesheet.absolute.csv")
                absoluteSamplesheet.text = rewrittenLines.join("\n") + "\n"

                outdir = "$outputDir"
                input = absoluteSamplesheet.toString()
                sample_ploidy = "2"
            }
        }

        then {
            assert workflow.success

            def manifestJson = new groovy.json.JsonSlurper().parse(
                new File("$outputDir/gs_panel/cohort.gs_panel.manifest.json")
            )
            assert manifestJson.schema_version == 2

            def containerDefaults = GsContainerDefaults.read(projectDir)
            def gatkDefault = containerDefaults.gatk

            // Overridden: recorded value differs from the default and
            // equals exactly what the fixture config set (the same
            // digest-only transformation the fixture applies).
            assert manifestJson.containers.gs_normalize_variants ==
                GsContainerDefaults.digestOnly(containerDefaults.bcftools)
            assert manifestJson.containers.gatk_variantfiltration_gs ==
                GsContainerDefaults.digestOnly(gatkDefault)

            // Not overridden: gs_index_classified_variants (the other
            // bcftools-based GS process) and gatk_selectpassvariants_gs
            // (the other GATK-based GS process) still show their
            // untouched defaults -- the override did not leak onto
            // sibling processes sharing the same tool.
            assert manifestJson.containers.gs_index_classified_variants ==
                containerDefaults.bcftools
            assert manifestJson.containers.gatk_selectpassvariants_gs == gatkDefault

            // The GATK_VARIANTFILTRATION_GS override must not have leaked
            // onto the primary (non-GS) lineage's own VariantFiltration
            // tasks: their real `.command.run` (the file whose
            // nxf_launch() embeds the literal `docker run ... <image>`
            // Nextflow actually used) must still show the default,
            // digest-pinned GATK image -- never the override that was
            // applied only via the fully-qualified GS-alias selector.
            // The needle is `--output <filename>`, not the bare filename:
            // GATK_SELECTPASSVARIANTS's own .command.sh also mentions
            // cohort.snp.filtered.vcf.gz (as its `--variant` *input*), so
            // matching on the bare filename would wrongly pull in that
            // sibling task's .command.run too.
            def overriddenGatk = GsContainerDefaults.digestOnly(gatkDefault)
            def primaryFilterRuns = findCommandRunScripts(outputDir.toString(), '--output cohort.snp.filtered.vcf.gz') +
                findCommandRunScripts(outputDir.toString(), '--output cohort.indel.filtered.vcf.gz')
            assert primaryFilterRuns.size() == 2
            assert primaryFilterRuns.every { it.contains(gatkDefault) }
            assert primaryFilterRuns.every { !it.contains(overriddenGatk) }

            def gsFilterRuns = findCommandRunScripts(outputDir.toString(), '--output cohort_gs.snp.filtered.vcf.gz')
            assert gsFilterRuns.size() == 1
            assert gsFilterRuns[0].contains(overriddenGatk)
            assert !gsFilterRuns[0].contains(gatkDefault)

            // Issue #42: the run-level manifest records effective
            // containers per process too, so the same two overrides must
            // reach it -- and must not leak onto the sibling alias or
            // onto any other process. This is the run-level counterpart
            // of the GS-manifest assertions above: a manifest that showed
            // the module default here would prove the override never
            // reached it.
            def runManifest = readRunManifest(outputDir.toString())

            assert runManifest.containers.gs_normalize_variants ==
                GsContainerDefaults.digestOnly(containerDefaults.bcftools)
            assert runManifest.containers.gatk_variantfiltration_gs == overriddenGatk

            // The primary lineage's own alias of the same module was not
            // overridden and must still show the default.
            assert runManifest.containers.gatk_variantfiltration == gatkDefault
            assert runManifest.containers.gatk_selectpassvariants_gs == gatkDefault
            assert runManifest.containers.gs_index_classified_variants ==
                containerDefaults.bcftools

            // ...and each recorded value is the image Nextflow really
            // launched that process with.
            def runManifestFilterRuns = findCommandRunScripts(
                outputDir.toString(),
                RUN_TASK_NEEDLES.gatk_variantfiltration,
            )
            assert runManifestFilterRuns.every { run ->
                run.contains(runManifest.containers.gatk_variantfiltration)
            }
            assert gsFilterRuns[0].contains(runManifest.containers.gatk_variantfiltration_gs)
        }
    }

    test("haploid sample_ploidy with the GS panel disabled resolves correct hemizygous genotypes end to end") {

        tag "issue42_run_manifest"


        when {
            params {
                // See the first test in this file for why the
                // samplesheet's paths are rewritten to absolute paths.
                def sourceLines = file("${projectDir}/tests/data/samplesheet.csv").readLines()
                def rewrittenLines = sourceLines.collect { line ->
                    line.replaceAll(
                        "tests/data/reads/",
                        "${projectDir}/tests/data/reads/"
                    )
                }
                def absoluteSamplesheet = new File("${outputDir}/samplesheet.absolute.csv")
                absoluteSamplesheet.text = rewrittenLines.join("\n") + "\n"

                outdir = "$outputDir"
                input = absoluteSamplesheet.toString()
                // Issue #20 review (P1-2): both set as Strings, not bare
                // Groovy literals, to reproduce exactly what Nextflow's
                // strict CLI parser hands `params` for a real
                // `--sample_ploidy 1 --enable_gs_panel false` invocation.
                // With native Integer/Boolean literals here, this test
                // would keep passing even if the `.toString().toInteger()`/
                // `.toString().toBoolean()` coercions in main.nf and
                // workflows/adzuki_snp_pipeline.nf were ever removed --
                // Integer 1 != 2 and Boolean false are already correct
                // without coercion, so only String inputs actually
                // exercise (and regression-guard) that code path.
                sample_ploidy = "1"
                enable_gs_panel = "false"
            }
        }

        then {
            assert workflow.success

            // Issue #20: sample_ploidy is now propagated to both
            // HaplotypeCaller and GenotypeGVCFs, so a non-default ploidy
            // must resolve real, non-diploid genotypes all the way
            // through to the raw cohort VCF, not just in the per-sample
            // gVCFs.
            assert path("$outputDir/variants/gvcf/sample_a.g.vcf.gz").exists()
            assert path("$outputDir/variants/gvcf/sample_a.g.vcf.gz.tbi").exists()
            assert path("$outputDir/variants/gvcf/sample_b.g.vcf.gz").exists()
            assert path("$outputDir/variants/gvcf/sample_b.g.vcf.gz.tbi").exists()

            // Issue #20 review (P1-2): GATK 4.6.2.0 was measured to
            // infer the correct ploidy from its GenomicsDB/gVCF input
            // whether or not --sample-ploidy is passed explicitly (see
            // the PR for the comparison), so the final genotype contract
            // checked below cannot, by itself, prove this PR's explicit
            // propagation is actually wired up. Check the real
            // GATKCommandLine header each tool embeds in its own output
            // instead.
            def gvcf_a_lines = path("$outputDir/variants/gvcf/sample_a.g.vcf.gz").linesGzip
            def gvcf_a_commandline = gvcf_a_lines.find { line -> line.startsWith("##GATKCommandLine=<ID=HaplotypeCaller") }
            assert gvcf_a_commandline != null: "no HaplotypeCaller ##GATKCommandLine header found in sample_a gVCF"
            assert gvcf_a_commandline.contains("--sample-ploidy 1")

            def raw_vcf = path("$outputDir/variants/raw/cohort.raw.vcf.gz")
            assert raw_vcf.exists()
            assert path("$outputDir/variants/raw/cohort.raw.vcf.gz.tbi").exists()

            def raw_lines = raw_vcf.linesGzip
            def header = raw_lines.find { line -> line.startsWith("#CHROM") }
            def data_lines = raw_lines.findAll { line -> !line.startsWith("#") }
            def headerColumns = header.split("\t")

            def raw_genotypegvcfs_commandline = raw_lines.find { line -> line.startsWith("##GATKCommandLine=<ID=GenotypeGVCFs") }
            assert raw_genotypegvcfs_commandline != null: "no GenotypeGVCFs ##GATKCommandLine header found in raw cohort VCF"
            assert raw_genotypegvcfs_commandline.contains("--sample-ploidy 1")

            assert header == "#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\tsample_a\tsample_b"
            assert data_lines.size() == 2

            def parseInfo = { String infoField ->
                infoField.split(";").collectEntries { entry ->
                    def keyValue = entry.split("=", 2)
                    [(keyValue[0]): (keyValue.size() > 1 ? keyValue[1] : "true")]
                }
            }
            def parseSample = { String formatField, String sampleField ->
                [formatField.split(":"), sampleField.split(":")]
                    .transpose()
                    .collectEntries { it }
            }

            // tests/data/variants/expected_variants_haploid.tsv is a
            // dedicated contract file for sample_ploidy=1, separate from
            // expected_variants.tsv (the diploid contract, which this
            // test does not read or modify). DP is deliberately not
            // asserted here, unlike the diploid contract: it is not
            // part of what Issue #20 validates, and this PR has no
            // empirical basis for pinning an exact haploid depth value.
            def contractLines = file("${projectDir}/tests/data/variants/expected_variants_haploid.tsv")
                .readLines()
                .findAll { line -> !line.trim().isEmpty() }
            def contractHeader = contractLines[0].split("\t")
            def contract = contractLines.drop(1).collect { line ->
                [contractHeader, line.split("\t")].transpose().collectEntries { it }
            }
            assert contract.size() == 2

            contract.each { expected ->
                def record = data_lines
                    .find { line -> line.startsWith("${expected.contig}\t${expected.position}\t") }
                    ?.split("\t")
                assert record != null: "no raw VCF record found for ${expected.contig}:${expected.position}"

                assert record[3] == expected.ref
                assert record[4] == expected.alt

                def info = parseInfo(record[7])
                assert info["AC"] == expected.ac
                assert info["AN"] == expected.an
                assert info["AF"].toDouble() == expected.af.toDouble()

                def altColumn = headerColumns.findIndexOf { column -> column == expected.alt_sample_id }
                def refColumn = headerColumns.findIndexOf { column -> column == expected.ref_sample_id }
                def altSample = parseSample(record[8], record[altColumn])
                def refSample = parseSample(record[8], record[refColumn])

                // A haploid GT is a single allele index (e.g. "1"), not
                // a "/"-joined pair like the diploid contract's "1/1".
                assert altSample["GT"] == expected.alt_genotype
                assert refSample["GT"] == expected.ref_genotype
            }

            // Issue #20 Phase 2: the GS lineage must not run at all when
            // disabled, so none of its output directories exist.
            assert !new File("$outputDir/gs_panel").exists()
            assert !new File("$outputDir/variants/gs_normalized").exists()
            assert !new File("$outputDir/variants/gs_classified").exists()
            assert !new File("$outputDir/variants/gs_filtered").exists()
            assert !new File("$outputDir/variants/gs_pass").exists()

            // the primary (non-GS) lineage still runs to completion
            assert path("$outputDir/variants/filtered/cohort.snp.filtered.vcf.gz").exists()
            assert path("$outputDir/variants/pass/cohort.snp.pass.vcf.gz").exists()

            // Issue #42: a run with the GS panel disabled still produces
            // a run-level provenance manifest -- provenance is not a
            // property of the GS lineage. `gs_panel` is an explicit null
            // rather than a missing field, so a reader can tell "this run
            // had no GS panel" apart from "this manifest predates the
            // field".
            def runManifest = readRunManifest(outputDir.toString())

            assert runManifest.schema_version == 2
            assert runManifest.cohort_id == "cohort"
            assert runManifest.containsKey("gs_panel")
            assert runManifest.gs_panel == null

            // The parameters that made this run different are recorded
            // as they were actually used.
            assert runManifest.parameters.enable_gs_panel == false
            assert runManifest.parameters.sample_ploidy == 1

            // No GS process ran, so no GS process key exists. A manifest
            // that listed them with their default images would be
            // claiming software touched this data when none did.
            def gsProcessKeys = [
                "gs_normalize_variants",
                "classify_normalized_variants",
                "gs_index_classified_variants",
                "gatk_variantfiltration_gs",
                "gatk_selectpassvariants_gs",
                "build_gs_panel",
                "reconcile_gs_panel_accounting",
                "build_gs_panel_manifest",
            ]
            gsProcessKeys.each { processKey ->
                assert !runManifest.containers.containsKey(processKey):
                    "run manifest recorded ${processKey}, but the GS lineage did not run"
            }

            // The primary lineage's own processes are still recorded,
            // including the QC side branch's terminal barrier.
            assert runManifest.containers.containsKey("gatk_variantfiltration")
            assert runManifest.containers.containsKey("gatk_selectpassvariants")
            assert runManifest.containers.containsKey("multiqc")
            assert runManifest.containers.containsKey("build_run_manifest")

            // ...and the recorded set is exactly what Nextflow executed
            // in this configuration -- no more, no less.
            assert runManifest.containers.keySet() ==
                executedProcessKeys(workflow.trace.tasks().collect { task -> task.name })

            // Accounting and checksums still cover the whole run.
            assert runManifest.sample_accounting.collect { row -> row.sample } ==
                ["sample_a", "sample_b"]
            assert runManifest.checksums.containsKey("cohort.raw.vcf.gz")
            assert runManifest.checksums["cohort.raw.vcf.gz"] ==
                sha256Of("$outputDir/variants/raw/cohort.raw.vcf.gz")
        }
    }

    test("sample_ploidy=1 with the GS panel enabled (default) fails fast before any analysis process runs") {

        when {
            params {
                def sourceLines = file("${projectDir}/tests/data/samplesheet.csv").readLines()
                def rewrittenLines = sourceLines.collect { line ->
                    line.replaceAll(
                        "tests/data/reads/",
                        "${projectDir}/tests/data/reads/"
                    )
                }
                def absoluteSamplesheet = new File("${outputDir}/samplesheet.absolute.csv")
                absoluteSamplesheet.text = rewrittenLines.join("\n") + "\n"

                outdir = "$outputDir"
                input = absoluteSamplesheet.toString()
                // String, not a bare Integer literal -- see the haploid
                // test above for why this matters for Issue #20's CLI
                // string-coercion regression guards.
                sample_ploidy = "1"
                // enable_gs_panel is left at its default (true): this is
                // exactly the invalid combination Issue #20 requires be
                // rejected before any process starts, since the GS panel
                // genotype encoding (diploid_additive_dosage_v1) is
                // diploid-only.
            }
        }

        then {
            assert !workflow.success
            assert workflow.stdout.join("\n").contains("diploid-only")

            // no analysis process (HaplotypeCaller or otherwise) may
            // have started -- the failure must happen before any work
            // is done, not after wasting a full variant-calling run.
            assert workflow.trace.tasks().isEmpty()

            // no pipeline output directories were created at all
            assert !new File("$outputDir/variants").exists()
            assert !new File("$outputDir/qc").exists()
            assert !new File("$outputDir/alignment").exists()
            assert !new File("$outputDir/gs_panel").exists()
        }
    }

    test("a negative optical_duplicate_pixel_distance is rejected before any process runs") {

        when {
            params {
                def sourceLines = file("${projectDir}/tests/data/samplesheet.csv").readLines()
                def rewrittenLines = sourceLines.collect { line ->
                    line.replaceAll(
                        "tests/data/reads/",
                        "${projectDir}/tests/data/reads/"
                    )
                }
                def absoluteSamplesheet = new File("${outputDir}/samplesheet.absolute.csv")
                absoluteSamplesheet.text = rewrittenLines.join("\n") + "\n"

                outdir = "$outputDir"
                input = absoluteSamplesheet.toString()
                // Issue #8: a CLI-equivalent String (not a bare Groovy
                // integer literal) -- schema validation must reject this
                // regardless of the value's Groovy runtime type, since a
                // real `--optical_duplicate_pixel_distance -5` CLI
                // invocation hands nf-schema exactly this String.
                optical_duplicate_pixel_distance = "-5"
            }
        }

        then {
            assert !workflow.success

            // PR #25 review (P2-3): assert the failure is actually the
            // optical_duplicate_pixel_distance range violation, not some
            // other schema or initialization error that would also
            // leave workflow.success false and no tasks/output behind.
            def output = (workflow.stdout + workflow.stderr).join("\n")
            assert output.contains("optical_duplicate_pixel_distance")
            assert output.contains("less than 0")

            // no analysis process (mapping, MarkDuplicates, or
            // otherwise) may have started -- the failure must happen at
            // schema validation, before any work is done.
            assert workflow.trace.tasks().isEmpty()

            assert !new File("$outputDir/variants").exists()
            assert !new File("$outputDir/qc").exists()
            assert !new File("$outputDir/alignment").exists()
            assert !new File("$outputDir/gs_panel").exists()
        }
    }

    test("a fully prebuilt (non-generated) BWA-MEM2 index completes the whole pipeline and skips BWA_MEM2_INDEX") {

        tag "issue42_run_manifest"


        when {
            params {
                def sourceLines = file("${projectDir}/tests/data/samplesheet.csv").readLines()
                def rewrittenLines = sourceLines.collect { line ->
                    line.replaceAll(
                        "tests/data/reads/",
                        "${projectDir}/tests/data/reads/"
                    )
                }
                def absoluteSamplesheet = new File("${outputDir}/samplesheet.absolute.csv")
                absoluteSamplesheet.text = rewrittenLines.join("\n") + "\n"

                outdir = "$outputDir"
                input = absoluteSamplesheet.toString()
                sample_ploidy = "2"
                // tests/data/reference/prebuilt_bwa_index/ (see
                // tests/modules/bwa_mem2_mem_sort.nf.test for how this
                // fixture was built and its recorded tool
                // version/checksums); bwa_index_prefix's basename must
                // match reference_fasta's basename (main.nf enforces
                // this), so the fixture directory's files are named
                // synthetic.fa.* to match tests/data/reference/synthetic.fa.
                bwa_index_prefix = "${projectDir}/tests/data/reference/prebuilt_bwa_index/synthetic.fa"
            }
        }

        then {
            assert workflow.success

            // BWA_MEM2_INDEX must not run at all when a prebuilt index
            // is supplied -- only the 3 BWA_MEM2_MEM_SORT mapping tasks
            // should reference bwa-mem2.
            def taskNames = workflow.trace.tasks().collect { task -> task.name }
            assert taskNames.every { name -> !name.contains("BWA_MEM2_INDEX") }
            assert taskNames.findAll { name -> name.contains("BWA_MEM2_MEM_SORT") }.size() == 3

            // PR #25 review (P2-1): the same diploid genotype/annotation
            // contract as the generated-index path above -- read from
            // tests/data/variants/expected_variants.tsv and asserted as
            // an exact match, not just a record count -- must still
            // hold: a prebuilt index is not expected to, and does not,
            // change alignment results for this fixture. A record-count
            // check alone would still pass even if REF/ALT, sample
            // order, GT, AC/AN/AF, or DP were wrong.
            def raw_vcf = path("$outputDir/variants/raw/cohort.raw.vcf.gz")
            def raw_lines = raw_vcf.linesGzip
            def header = raw_lines.find { line -> line.startsWith("#CHROM") }
            def data_lines = raw_lines.findAll { line -> !line.startsWith("#") }
            def headerColumns = header.split("\t")

            assert header == "#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\tsample_a\tsample_b"
            assert data_lines.size() == 2

            def parseInfo = { String infoField ->
                infoField.split(";").collectEntries { entry ->
                    def keyValue = entry.split("=", 2)
                    [(keyValue[0]): (keyValue.size() > 1 ? keyValue[1] : "true")]
                }
            }
            def parseSample = { String formatField, String sampleField ->
                [formatField.split(":"), sampleField.split(":")]
                    .transpose()
                    .collectEntries { it }
            }

            def contractLines = file("${projectDir}/tests/data/variants/expected_variants.tsv")
                .readLines()
                .findAll { line -> !line.trim().isEmpty() }
            def contractHeader = contractLines[0].split("\t")
            def contract = contractLines.drop(1).collect { line ->
                [contractHeader, line.split("\t")].transpose().collectEntries { it }
            }
            assert contract.size() == 2

            contract.each { expected ->
                def record = data_lines
                    .find { line -> line.startsWith("${expected.contig}\t${expected.position}\t") }
                    ?.split("\t")
                assert record != null: "no raw VCF record found for ${expected.contig}:${expected.position}"

                assert record[3] == expected.ref
                assert record[4] == expected.alt

                def info = parseInfo(record[7])
                assert info["AC"] == expected.ac
                assert info["AN"] == expected.an
                assert info["AF"].toDouble() == expected.af.toDouble()
                assert info["DP"] == expected.site_dp

                def altColumn = headerColumns.findIndexOf { column -> column == expected.alt_sample_id }
                def refColumn = headerColumns.findIndexOf { column -> column == expected.ref_sample_id }
                def altSample = parseSample(record[8], record[altColumn])
                def refSample = parseSample(record[8], record[refColumn])

                assert altSample["GT"] == expected.alt_genotype
                assert altSample["DP"] == expected.alt_sample_dp
                assert refSample["GT"] == expected.ref_genotype
                assert refSample["DP"] == expected.ref_sample_dp
            }

            // Issue #42: BWA_MEM2_INDEX never ran in this configuration,
            // so the run manifest must not carry a `bwa_mem2_index`
            // entry -- `containers` lists the processes this run
            // executed, not the processes it could have executed under a
            // different configuration. The reference-preparation
            // processes that *did* run (this run supplies neither a
            // prebuilt FAI nor a prebuilt dictionary) are still recorded.
            def runManifest = readRunManifest(outputDir.toString())

            assert !runManifest.containers.containsKey("bwa_mem2_index")
            assert runManifest.containers.containsKey("samtools_faidx")
            assert runManifest.containers.containsKey("gatk_create_sequence_dictionary")
            assert runManifest.containers.containsKey("bwa_mem2_mem_sort")

            // The prebuilt index files this run actually mapped against
            // are still recorded, by basename and by a checksum this test
            // computes independently from the fixture on disk.
            assert runManifest.reference.bwa_index.collect { entry -> entry.filename } == [
                "synthetic.fa.0123",
                "synthetic.fa.amb",
                "synthetic.fa.ann",
                "synthetic.fa.bwt.2bit.64",
                "synthetic.fa.pac",
            ]
            runManifest.reference.bwa_index.each { entry ->
                assert entry.checksum == sha256Of(
                    "${projectDir}/tests/data/reference/prebuilt_bwa_index/${entry.filename}"
                ): "prebuilt index ${entry.filename} is not the file the manifest recorded"
            }
        }
    }

    test("a non-default genomicsdb_batch_size reaches every real GenomicsDBImport invocation") {

        when {
            params {
                def sourceLines = file("${projectDir}/tests/data/samplesheet.csv").readLines()
                def rewrittenLines = sourceLines.collect { line ->
                    line.replaceAll(
                        "tests/data/reads/",
                        "${projectDir}/tests/data/reads/"
                    )
                }
                def absoluteSamplesheet = new File("${outputDir}/samplesheet.absolute.csv")
                absoluteSamplesheet.text = rewrittenLines.join("\n") + "\n"

                outdir = "$outputDir"
                input = absoluteSamplesheet.toString()
                sample_ploidy = "2"
                // Issue #11: a String, not a bare Groovy integer literal
                // (see the sample_ploidy/optical_duplicate_pixel_distance
                // comments elsewhere in this file for why this matters
                // for CLI-equivalent type coercion), and deliberately NOT
                // the default (50) -- with 1-2 sample synthetic fixtures
                // the raw cohort VCF's contents are identical regardless
                // of --batch-size, so only reading the real rendered
                // command (below) can prove this actually propagated,
                // not just that the pipeline still produced correct
                // output.
                genomicsdb_batch_size = "7"
            }
        }

        then {
            assert workflow.success

            def genomicsDbScripts = findCommandScripts("$outputDir", "GenomicsDBImport")
            assert genomicsDbScripts.size() == 2
            genomicsDbScripts.each { script ->
                assert script.contains("--batch-size 7")
                assert !script.contains("--batch-size 50")
            }

            // the rest of the genotype contract is unaffected by
            // batch-size -- confirms this parameter does not silently
            // change GenomicsDBImport's actual variant output
            assert path("$outputDir/variants/raw/cohort.raw.vcf.gz").exists()
            def data_lines = path("$outputDir/variants/raw/cohort.raw.vcf.gz")
                .linesGzip
                .findAll { line -> !line.startsWith("#") }
            assert data_lines.size() == 2
        }
    }

    test("genomicsdb_batch_size=0 is rejected before any process runs") {

        when {
            params {
                def sourceLines = file("${projectDir}/tests/data/samplesheet.csv").readLines()
                def rewrittenLines = sourceLines.collect { line ->
                    line.replaceAll(
                        "tests/data/reads/",
                        "${projectDir}/tests/data/reads/"
                    )
                }
                def absoluteSamplesheet = new File("${outputDir}/samplesheet.absolute.csv")
                absoluteSamplesheet.text = rewrittenLines.join("\n") + "\n"

                outdir = "$outputDir"
                input = absoluteSamplesheet.toString()
                genomicsdb_batch_size = "0"
            }
        }

        then {
            assert !workflow.success
            def output = (workflow.stdout + workflow.stderr).join("\n")
            assert output.contains("genomicsdb_batch_size")
            assert workflow.trace.tasks().isEmpty()
        }
    }

