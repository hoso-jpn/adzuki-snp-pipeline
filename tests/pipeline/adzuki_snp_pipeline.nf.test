    test("a matching prebuilt reference_fai/reference_dict pair completes the whole pipeline") {

        when {
            params {
                def sourceLines = file("${projectDir}/tests/data/samplesheet.csv").readLines()
                def rewrittenLines = sourceLines.collect { line ->
                    line.replaceAll(
                        "tests/data/reads/",
                        "${projectDir}/tests/data/reads/"
                    )
                }
                def absoluteSamplesheet = new File("${outputDir}/samplesheet.absolute.csv")
                absoluteSamplesheet.text = rewrittenLines.join("\n") + "\n"

                outdir = "$outputDir"
                input = absoluteSamplesheet.toString()
                sample_ploidy = "2"
                reference_fai = "${projectDir}/tests/data/reference/synthetic.fa.fai"
                // tests/data/reference/prebuilt_dict/: built once via
                // `docker run
                // broadinstitute/gatk:4.6.2.0@sha256:71b17ee42d149e8ec112603f5305c873ab60d93949ef8bb62a4fff85427f56fb
                // gatk CreateSequenceDictionary --REFERENCE synthetic.fa
                // --OUTPUT synthetic.dict` (the exact same pinned digest
                // GATK_CREATE_SEQUENCE_DICTIONARY uses), so this exercises
                // a real, reproducibly-generated .dict supplied through
                // the prebuilt path, not a hand-written one. Its `UR:`
                // fields record the container-internal build path
                // (/data/synthetic.fa) verbatim from that real run;
                // validate_reference_contigs.py never reads UR/M5, only
                // SN:/LN:, so this is cosmetic. Checksum recorded in
                // CHECKSUMS.sha256 alongside the fixture.
                reference_dict = "${projectDir}/tests/data/reference/prebuilt_dict/synthetic.dict"
            }
        }

        then {
            assert workflow.success

            // GATK_CREATE_SEQUENCE_DICTIONARY must not run at all when a
            // prebuilt dict is supplied.
            def taskNames = workflow.trace.tasks().collect { task -> task.name }
            assert taskNames.every { name -> !name.contains("GATK_CREATE_SEQUENCE_DICTIONARY") }

            assert path("$outputDir/variants/raw/cohort.raw.vcf.gz").exists()
            def data_lines = path("$outputDir/variants/raw/cohort.raw.vcf.gz")
                .linesGzip
                .findAll { line -> !line.startsWith("#") }
            assert data_lines.size() == 2
        }
    }

    test("a prebuilt reference_dict whose contigs are reordered relative to reference_fai fails before any process runs") {

        tag "reference-validation-gate"

        when {
            params {
                def sourceLines = file("${projectDir}/tests/data/samplesheet.csv").readLines()
                def rewrittenLines = sourceLines.collect { line ->
                    line.replaceAll(
                        "tests/data/reads/",
                        "${projectDir}/tests/data/reads/"
                    )
                }
                def absoluteSamplesheet = new File("${outputDir}/samplesheet.absolute.csv")
                absoluteSamplesheet.text = rewrittenLines.join("\n") + "\n"

                outdir = "$outputDir"
                input = absoluteSamplesheet.toString()
                reference_fai = "${projectDir}/tests/data/reference/synthetic.fa.fai"
                // The exact same two real @SQ lines as
                // tests/data/reference/prebuilt_dict/synthetic.dict
                // (the "prebuilt success" test above), just reordered --
                // same contig set as reference_fai, same lengths, only
                // the order differs. This is the specific case a naive
                // set-equality comparison would miss. In its own
                // directory (not alongside prebuilt_dict/synthetic.dict)
                // because main.nf requires reference_dict's basename to
                // match reference_fasta's basename (synthetic.dict).
                reference_dict = "${projectDir}/tests/data/reference/prebuilt_dict_reordered/synthetic.dict"
            }
        }

        then {
            assert !workflow.success

            // Permanent structural guard for the dependency that the main
            // push CI race exposed: the mapper must consume the read channel
            // combined with VALIDATE_REFERENCE_CONTIGS's successful output,
            // not FASTP.out.reads directly. The runtime assertions below then
            // verify the observable failure contract without sleeps/timing.
            def workflowSource = file("${projectDir}/workflows/adzuki_snp_pipeline.nf").text
            assert workflowSource.contains(
                "validated_mapping_reads_ch = FASTP.out.reads\n" +
                "        .combine(reference_validation_gate_ch)"
            )
            assert workflowSource =~ /BWA_MEM2_MEM_SORT\(\s*validated_mapping_reads_ch,/

            def output = (workflow.stdout + workflow.stderr).join("\n")
            assert output.contains("reference FAI and sequence dictionary are inconsistent")
            assert output.contains("first mismatch at index 0")

            // No process that actually depends on reference_fai/
            // reference_dict may have started -- the failure must happen
            // at the VALIDATE_REFERENCE_CONTIGS gate, before any mapping
            // or variant-calling work is done. FASTQC_RAW/FASTP/
            // BWA_MEM2_INDEX have no data dependency on reference_fai/
            // reference_dict at all (BWA_MEM2_INDEX only needs the fasta)
            // and may legitimately have already completed concurrently
            // by the time this failure is reported -- so isEmpty(), or a
            // blanket "no BWA_MEM2* task", would both be too strong a
            // claim here, and is not what this test is about.
            def taskNames = workflow.trace.tasks().collect { task -> task.name }
            assert taskNames.every { name ->
                !name.contains("BWA_MEM2_MEM_SORT") && !name.contains("HAPLOTYPECALLER") &&
                !name.contains("GENOMICSDBIMPORT") && !name.contains("GENOTYPEGVCFS")
            }
        }
    }

    test("one sample and one read group reaches MultiQC through real single-emission QC channels") {

        when {
            params {
                def sourceLines = file("${projectDir}/tests/data/samplesheet.csv").readLines()
                def sampleBLine = sourceLines.find { line -> line.startsWith("sample_b,") }
                assert sampleBLine != null
                def rewrittenLine = sampleBLine.replaceAll(
                    "tests/data/reads/",
                    "${projectDir}/tests/data/reads/"
                )
                def singleSampleSheet = new File("${outputDir}/samplesheet.single-sample.csv")
                singleSampleSheet.text = sourceLines[0] + "\n" + rewrittenLine + "\n"

                outdir = "$outputDir"
                input = singleSampleSheet.toString()
            }
        }

        then {
            assert workflow.success

            def multiqcJsonFile = path("$outputDir/qc/multiqc/multiqc_data/multiqc_data.json")
            assert multiqcJsonFile.exists()
            def multiqc = new groovy.json.JsonSlurper().parse(multiqcJsonFile.toFile())
            def parsed = multiqc.report_saved_raw_data

            assert parsed.multiqc_fastqc.keySet() as Set == [
                "sample_b_L001.raw.R1",
                "sample_b_L001.raw.R2",
                "sample_b_L001.trimmed.R1",
                "sample_b_L001.trimmed.R2",
            ] as Set
            assert parsed.multiqc_fastp.keySet() as Set == ["sample_b_L001"] as Set
            assert parsed.multiqc_picard_dups.keySet() as Set == ["sample_b"] as Set
            assert parsed.multiqc_samtools_flagstat.keySet() as Set == ["sample_b"] as Set
            assert parsed.multiqc_samtools_stats.keySet() as Set == ["sample_b"] as Set
            assert parsed.multiqc_samtools_idxstats.keySet() as Set == ["sample_b"] as Set

            def sources = multiqc.report_data_sources
            assert sources.Picard.DuplicationMetrics.size() == 1
            assert sources.Samtools.flagstat.size() == 1
            assert sources.Samtools.stats.size() == 1
            assert sources.Samtools.idxstats.size() == 1
            assert sources.fastp.all_sections.size() == 1
            assert sources.FastQC.all_sections.size() == 4
        }
    }
}
