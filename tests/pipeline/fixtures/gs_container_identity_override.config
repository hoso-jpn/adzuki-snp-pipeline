// Issue #52 regression fixture: exercises two independent *process-specific*
// container override mechanisms in a single pipeline run, so the GS panel
// manifest test can prove both are captured (never the process's own
// `container` directive default) without needing two separate full pipeline
// runs:
//
//   - a plain `withName` override on GS_NORMALIZE_VARIANTS, which has no
//     non-GS alias, proving a simple override reaches the manifest;
//   - a fully-qualified `withName` override that targets only the
//     GATK_VARIANTFILTRATION_GS alias of the shared
//     modules/local/gatk_variantfiltration.nf module, leaving its sibling
//     alias GATK_VARIANTFILTRATION (used by the primary, non-GS lineage)
//     untouched -- proving a fully-qualified selector is honored and that
//     the two aliases' effective containers are never conflated.
//
// Changing the *default* itself (params.containers, the single source of
// truth) is the separate scenario in
// tests/pipeline/fixtures/gs_container_default_change.config.
//
// Both overrides point at the exact same underlying image this repository
// already pins by default, referenced by digest alone with its tag dropped:
// the override therefore needs no extra image pull (the content is already
// cached from every default-config test in this file) and never depends on
// a mutable tag still resolving to the same bytes, while still being a
// distinct literal string from the default -- which is what these
// assertions actually check for. The values are derived from
// conf/containers.config rather than copied here, so this fixture holds no
// pinned production digest of its own; `includeConfig` is required for
// that, since `params` set by another config file is not visible while this
// one is parsed. GsContainerDefaults.digestOnly() in tests/lib/ applies the
// identical transformation so the test can state what it expects.
includeConfig '../../../conf/containers.config'

process {
    withName: '^GS_NORMALIZE_VARIANTS$' {
        container = params.containers.bcftools.replaceFirst(/:[^@]+@/, '@')
    }

    withName: 'ADZUKI_SNP_PIPELINE:GATK_VARIANTFILTRATION_GS' {
        container = params.containers.gatk.replaceFirst(/:[^@]+@/, '@')
    }
}
