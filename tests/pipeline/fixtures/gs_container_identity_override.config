// Issue #52 regression fixture: exercises two independent container
// override mechanisms in a single pipeline run, so the GS panel manifest
// test can prove both are captured (never the module's own hardcoded
// default) without needing three separate full pipeline runs:
//
//   - a plain `withName` override on GS_NORMALIZE_VARIANTS, which has no
//     non-GS alias, proving a simple override reaches the manifest;
//   - a fully-qualified `withName` override that targets only the
//     GATK_VARIANTFILTRATION_GS alias of the shared
//     modules/local/gatk_variantfiltration.nf module, leaving its sibling
//     alias GATK_VARIANTFILTRATION (used by the primary, non-GS lineage)
//     untouched -- proving a fully-qualified selector is honored and that
//     the two aliases' effective containers are never conflated.
//
// Both overrides point at the exact same underlying image already pinned
// as this repository's default, just referenced without the `@sha256:...`
// digest suffix: the override therefore needs no extra image pull (the
// content is already cached from every default-config test in this file)
// while still being a distinct literal string from the hardcoded default,
// which is what these assertions actually check for.
process {
    withName: '^GS_NORMALIZE_VARIANTS$' {
        container = 'quay.io/biocontainers/bcftools:1.24--h118bc1c_2'
    }

    withName: 'ADZUKI_SNP_PIPELINE:GATK_VARIANTFILTRATION_GS' {
        container = 'broadinstitute/gatk:4.6.2.0'
    }
}
