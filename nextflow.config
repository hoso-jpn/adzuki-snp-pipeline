manifest {
    name            = 'hoso-jpn/adzuki-snp-pipeline'
    author          = 'Yusuke Hosokawa'
    homePage        = 'https://github.com/hoso-jpn/adzuki-snp-pipeline'
    description     = 'Nextflow validation scaffold for an adzuki bean SNP-calling pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.04.0'
    version         = '0.1.0-dev'
}

plugins {
    id 'nf-schema@2.8.0'
}

params {
    input               = null
    outdir              = 'results'
    reference_id        = null
    reference_name      = null
    reference_fasta     = null
    reference_accession = ''
    reference_species   = ''
    reference_cultivar  = ''
    reference_fai       = null
    reference_dict      = null
    bwa_index_prefix    = null
}

process.executor = 'local'

validation {
    help {
        enabled = true
    }
    logging {
        unrecognisedParams  = 'error'
        unrecognisedHeaders = 'error'
    }
}

profiles {
    test {
        includeConfig 'conf/test.config'
    }
}
