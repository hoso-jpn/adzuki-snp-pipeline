manifest {
    name            = 'hoso-jpn/adzuki-snp-pipeline'
    author          = 'Yusuke Hosokawa'
    homePage        = 'https://github.com/hoso-jpn/adzuki-snp-pipeline'
    description     = 'Reproducible adzuki bean SNP-calling pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.04.0'
    version         = '0.2.0'
}

plugins {
    id 'nf-schema@2.8.0'
}

params {
    input               = null
    outdir              = 'results'
    reference_id        = null
    reference_name      = null
    reference_fasta     = null
    reference_accession = ''
    reference_species   = ''
    reference_cultivar  = ''
    reference_fai       = null
    reference_dict      = null
    bwa_index_prefix    = null
    sample_ploidy      = 2
    enable_gs_panel    = true
    optical_duplicate_pixel_distance = 100
    genomicsdb_batch_size = 50

    snp_filter_qd_min                 = 2.0
    snp_filter_qual_min               = 30.0
    snp_filter_sor_max                = 3.0
    snp_filter_fs_max                 = 60.0
    snp_filter_mq_min                 = 40.0
    snp_filter_mq_rank_sum_min        = -12.5
    snp_filter_read_pos_rank_sum_min  = -8.0
    indel_filter_qd_min               = 2.0
    indel_filter_qual_min             = 30.0
    indel_filter_fs_max               = 200.0
    indel_filter_read_pos_rank_sum_min = -20.0
}

process.executor = 'local'

process {
    errorStrategy = {
        task.exitStatus in [137, 140, 143]
            ? 'retry'
            : 'terminate'
    }
    // Issue #8: a plain retry on an OOM-like exit code (137/140/143)
    // previously re-ran the exact same command under the exact same
    // memory limit, which cannot succeed if the first attempt was
    // genuinely killed for exceeding it -- the retry only helps for a
    // transient scheduling/contention failure, never a real OOM. Most
    // retryable labels below scale `memory` by `task.attempt`; a
    // process-specific label may instead fail fast when automatic
    // escalation would exceed host-safe operating bounds.
    maxRetries = 1

    withLabel: process_low {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = '2h'
    }

    withLabel: process_medium {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = '8h'
    }

    withLabel: process_high {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = '24h'
    }

    // Issue #30: a dedicated label for GATK_HAPLOTYPECALLER specifically
    // (not process_high, which GATK_GENOTYPEGVCFS also uses), so this
    // cpus value reflects what was actually benchmarked and does not
    // silently change GATK_GENOTYPEGVCFS's own scheduler concurrency as
    // a side effect. Sized from an isolated (no concurrent tasks)
    // real-data benchmark comparing 8 vs. 4 cpus for
    // GATK_HAPLOTYPECALLER against the same real markdup BAM
    // (SRR29909135, Issue #26) on Seedcore-01's 32 logical CPUs:
    //
    //   cpus   wall time   peak RSS   real %cpu (of allocated cpus)
    //   8      40m45s      10.56 GiB  54.1% (4.33 of 8 cores used)
    //   4      42m10s      10.21 GiB  64.5% (2.58 of 4 cores used)
    //
    // 8 cpus bought only ~3.5% less wall time than 4 -- GATK's
    // PairHMM-threaded region barely scales past ~4 threads for this
    // reference/workload -- while every real variant record's
    // CHROM/POS/REF/ALT was confirmed byte-identical between the two
    // runs' gVCFs (1,134,549 records each, zero diff). At 4 cpus,
    // floor(32/4) = 8 of these tasks can run concurrently instead of
    // floor(32/8) = 4, roughly doubling this host's HaplotypeCaller
    // throughput for a multi-sample cohort at essentially no per-task
    // cost. GATK_GENOTYPEGVCFS does not read task.cpus at all and stays
    // on process_high (cpus=8) unchanged -- whether that value is
    // actually needed for GenotypeGVCFs is a separate, unbenchmarked
    // question this Issue deliberately does not answer, and this label
    // split means a future answer to it can change process_high without
    // touching this value. See docs/real_cohort_resource_hardening.md
    // for the full benchmark, including why this is a single-sample,
    // single-machine measurement and not a validation of
    // 20-30/327-sample throughput.
    withLabel: process_haplotypecaller {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = '24h'
    }

    // Issue #8: BWA_MEM2_MEM_SORT and BWA_MEM2_INDEX get their own
    // labels, independent of process_high and of each other, so their
    // resource allocations can be tuned separately once Phase 5's
    // real-reference measurements are available, without perturbing
    // every other process_high-labeled stage. At the time this comment
    // was written that meant GATK HaplotypeCaller and GenotypeGVCFs;
    // Issue #30 later moved HaplotypeCaller to its own
    // process_haplotypecaller label (see above), so process_high's only
    // remaining consumer is GenotypeGVCFs. Both process_mapping/
    // process_bwa_index started at the same cpus/memory process_high
    // used for these two processes at the time -- an unchanged
    // carry-over value, not a new guess -- specifically so this split
    // introduced no numeric change on its own.
    withLabel: process_mapping {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = '24h'
    }

    withLabel: process_bwa_index {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = '24h'
    }

    // Issue #11: GATK_GENOMICSDBIMPORT gets its own label, independent
    // of process_high, so its memory can be tuned separately once real
    // multi-sample cohort data (Issue #26) reveals GenomicsDBImport's
    // actual native/TileDB memory footprint at scale -- without
    // perturbing every other process_high-labeled stage. cpus/memory/
    // time are carried over from process_high unchanged; no real
    // multi-sample measurement yet justifies different values.
    withLabel: process_genomicsdb {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = '24h'
    }

    // Issue #30: CLASSIFY_NORMALIZED_VARIANTS, SUMMARIZE_FILTER_QC, and
    // BUILD_GS_PANEL previously shared process_low (cpus=2,
    // memory={4.GB * task.attempt}) with 13 other lightweight
    // processes, but Issue #26's real 5-sample cohort run showed this
    // is not a "lightweight" allocation for these three specifically:
    // CLASSIFY_NORMALIZED_VARIANTS and SUMMARIZE_FILTER_QC (cohort:snp)
    // were both OOM-killed (exit 137) at the 4 GiB first attempt, and
    // BUILD_GS_PANEL completed at 4 GiB but only by way of swap, not
    // genuine headroom (see below). Rather than raise process_low
    // itself -- which would also over-allocate the other 13
    // genuinely lightweight processes still on it -- each gets its own
    // label, sized from a targeted real-data benchmark (Issue #30) that
    // reused Issue #26's own already-published cohort artifacts
    // (cohort_gs.normalized.vcf.gz, cohort.snp.filtered.vcf.gz,
    // cohort_gs.snp.pass.vcf.gz) at a deliberately generous memory
    // ceiling, specifically so the reported peak RSS reflects genuine
    // consumption rather than being capped by a too-small cgroup limit:
    //
    //   process                            true peak RSS   new attempt-1 memory   headroom
    //   CLASSIFY_NORMALIZED_VARIANTS        9.33 GiB        12 GiB                 22.3%
    //   SUMMARIZE_FILTER_QC (cohort:snp)    8.43 GiB        12 GiB                 29.8%
    //   BUILD_GS_PANEL                      5.34 GiB         8 GiB                 33.3%
    //
    // BUILD_GS_PANEL's true peak RSS (5.34 GiB) is itself evidence the
    // original run's own trace ("peak_rss: 4 GB", the exact cgroup
    // ceiling) was not a true reading -- the task likely survived via
    // swap (this host has 15 GiB configured) rather than genuine
    // headroom. See docs/real_cohort_resource_hardening.md for the
    // full benchmark methodology and this repository's own standing
    // caveat that this is 5-sample evidence, not a 20-30/327-sample
    // validation. `cpus`/`time` are carried over from process_low
    // unchanged (%cpu measured ~100% -- effectively single-threaded --
    // and wall time was under 3 minutes even at this cohort's scale,
    // neither is the constraint these labels exist to address).
    //
    // Issue #33: the 5-sample values above did not hold at 10 samples.
    // Issue #33's real 10-sample cohort run (same real production
    // code, no code changes) OOM-killed CLASSIFY_NORMALIZED_VARIANTS
    // at its 12 GiB first attempt and only "succeeded" on its 24 GiB
    // retry by way of swap (host swap usage spiked to 10.5 GiB during
    // that exact window) -- not genuine headroom, and with
    // maxRetries=1 there was no further retry margin left.
    // SUMMARIZE_FILTER_QC (cohort:snp) and BUILD_GS_PANEL both
    // "succeeded" on their first attempt but landed exactly at their
    // memory ceiling (12 GB and 8 GB respectively) -- the same
    // cgroup-capped/swap-assisted false-positive pattern identified in
    // Issue #30. A dedicated real-data benchmark (same methodology as
    // Issue #30: the real 10-sample cohort's own already-published
    // artifacts, replayed at a deliberately generous 48 GiB ceiling so
    // the reported figure is genuine, unconstrained usage) found:
    //
    //   process                            true peak RSS (10 samples)
    //   CLASSIFY_NORMALIZED_VARIANTS        28.47 GiB
    //   SUMMARIZE_FILTER_QC (cohort:snp)    16.28 GiB
    //   BUILD_GS_PANEL                      12.65 GiB
    //
    // All three outputs were confirmed semantically equivalent to the
    // real run's own production outputs (identical accounting figures,
    // identical GS panel matrix/metadata row counts). New first-attempt
    // values below give each real, positive headroom over its
    // confirmed 10-sample true peak -- not a formula extrapolated from
    // two data points, and not validated at 20-30/327 samples, which
    // would need their own re-measurement at those scales.
    //
    // Issue #33 (second finding, at 20 samples): the 10-sample-derived
    // values above did not hold either. The real 20-sample cohort run
    // (10 samples reused via -resume + 10 new) again "succeeded" on
    // CLASSIFY_NORMALIZED_VARIANTS and BUILD_GS_PANEL's first attempt,
    // but both landed suspiciously close to/at their ceiling (39.9/40
    // GiB and 17/17 GiB respectively); the host-level monitor shows
    // real swap spikes (7.21 GiB and 5.42 GiB respectively) during
    // each task's exact window, confirming both were swap-assisted
    // false positives, not genuine headroom. A repeat of the same
    // isolated real-data benchmark (20-sample cohort's own artifacts,
    // each process run alone at a generous 96 GiB ceiling, since the
    // two tasks had run concurrently in production and could otherwise
    // have contaminated each other's reading) found:
    //
    //   process                            true peak RSS (20 samples)
    //   CLASSIFY_NORMALIZED_VARIANTS        53.36 GiB
    //   SUMMARIZE_FILTER_QC (cohort:snp)    19.91 GiB (genuine -- no
    //                                        swap spike coincided with
    //                                        this task's own window;
    //                                        22 GiB budget holds, with
    //                                        a now-thin 9.5% headroom
    //                                        worth re-checking at 30
    //                                        samples)
    //   BUILD_GS_PANEL                      19.88 GiB
    //
    // All three benchmark outputs again matched the real run's
    // production outputs exactly. Growth from 10->20 samples was
    // roughly linear for BUILD_GS_PANEL (~1.6x) but nearly 2x for
    // CLASSIFY_NORMALIZED_VARIANTS -- another reminder this is
    // observed real-data evidence at each scale actually measured, not
    // a formula projected forward to 30/327 samples.
    //
    // Issue #35 replaced the all-record representation with locus-local
    // streaming. Formal isolated replays at implementation SHA 70ae4d6
    // measured the classifier Python process itself at 20.83 MiB (10
    // samples) and 20.90 MiB (20 samples), with zero host swap delta and
    // byte-identical scientific output. The corresponding cgroup peaks
    // were 4.53 and 7.43 GiB because this process writes 4.0/7.7 GB plain
    // VCFs and Linux charges reclaimable output page cache to the cgroup.
    // 10 GiB is therefore based on the larger end-to-end cgroup reading,
    // not a mechanical reduction to the <=4 GiB Python-RSS target: it
    // leaves about 25% operational headroom over the measured 20-sample
    // cgroup peak and far more over the bounded classifier working set.
    // Keep fail-fast behavior: an OOM indicates a new scale/pathology to
    // preserve and re-benchmark, rather than a reason to hide it behind a
    // retry with a different resource contract.
    withLabel: process_variant_classification {
        cpus   = 2
        memory = 10.GB
        time   = '2h'

        errorStrategy = 'terminate'
        maxRetries    = 0
    }

    withLabel: process_variant_qc_summary {
        cpus   = 2
        memory = { 22.GB * task.attempt }
        time   = '2h'
    }

    withLabel: process_gs_panel {
        cpus   = 2
        memory = { 27.GB * task.attempt }
        time   = '2h'
    }

    withName: FASTQC_RAW {
        publishDir = [
            path   : "${params.outdir}/qc/fastqc/raw",
            mode   : 'copy',
            pattern: '*_fastqc.{html,zip}'
        ]
    }

    withName: FASTQC_TRIMMED {
        publishDir = [
            path   : "${params.outdir}/qc/fastqc/trimmed",
            mode   : 'copy',
            pattern: '*_fastqc.{html,zip}'
        ]
    }

    withName: GATK_HAPLOTYPECALLER {
        publishDir = [
            path   : "${params.outdir}/variants/gvcf",
            mode   : 'copy',
            pattern: '*.g.vcf.gz*'
        ]
    }

    withName: GATK_GATHERVCFS {
        publishDir = [
            path   : "${params.outdir}/variants/raw",
            mode   : 'copy',
            pattern: '*.raw.vcf.gz*'
        ]
    }

    withName: GATK_SELECTVARIANTS {
        publishDir = [
            path   : "${params.outdir}/variants/by_type",
            mode   : 'copy',
            pattern: '*.vcf.gz*'
        ]
    }

    withName: GATK_VARIANTFILTRATION {
        publishDir = [
            path   : "${params.outdir}/variants/filtered",
            mode   : 'copy',
            pattern: '*.filtered.vcf.gz*'
        ]
    }

    withName: GATK_SELECTPASSVARIANTS {
        publishDir = [
            path   : "${params.outdir}/variants/pass",
            mode   : 'copy',
            pattern: '*.pass.vcf.gz*'
        ]
    }

    withName: BCFTOOLS_STATS {
        publishDir = [
            path   : "${params.outdir}/qc/variants",
            mode   : 'copy',
            pattern: '*.{tsv,txt}'
        ]
    }

    withName: SUMMARIZE_VARIANT_QC {
        publishDir = [
            path   : "${params.outdir}/qc/variants",
            mode   : 'copy',
            pattern: '*.{tsv,txt}'
        ]
    }

    withName: SUMMARIZE_FILTER_QC {
        publishDir = [
            path   : "${params.outdir}/qc/variants",
            mode   : 'copy',
            pattern: '*.{tsv,txt}'
        ]
    }

    withName: RECONCILE_VARIANT_TYPE_COUNTS {
        publishDir = [
            path   : "${params.outdir}/qc/variants",
            mode   : 'copy',
            pattern: '*.{tsv,txt}'
        ]
    }

    withName: GS_NORMALIZE_VARIANTS {
        publishDir = [
            path   : "${params.outdir}/variants/gs_normalized",
            mode   : 'copy',
            pattern: '*.{normalized.vcf.gz,normalized.vcf.gz.tbi,normalize.report.txt}'
        ]
    }

    withName: CLASSIFY_NORMALIZED_VARIANTS {
        publishDir = [
            path   : "${params.outdir}/qc/variants",
            mode   : 'copy',
            pattern: '*.{tsv,txt}'
        ]
    }

    withName: GS_INDEX_CLASSIFIED_VARIANTS {
        publishDir = [
            path   : "${params.outdir}/variants/gs_classified",
            mode   : 'copy',
            pattern: '*.classified.vcf.gz*'
        ]
    }

    withName: GATK_VARIANTFILTRATION_GS {
        publishDir = [
            path   : "${params.outdir}/variants/gs_filtered",
            mode   : 'copy',
            pattern: '*.filtered.vcf.gz*'
        ]
    }

    withName: GATK_SELECTPASSVARIANTS_GS {
        publishDir = [
            path   : "${params.outdir}/variants/gs_pass",
            mode   : 'copy',
            pattern: '*.pass.vcf.gz*'
        ]
    }

    withName: BUILD_GS_PANEL {
        publishDir = [
            path   : "${params.outdir}/gs_panel",
            mode   : 'copy',
            pattern: '*.{tsv,tsv.gz,txt}'
        ]
    }

    withName: RECONCILE_GS_PANEL_ACCOUNTING {
        publishDir = [
            path   : "${params.outdir}/gs_panel",
            mode   : 'copy',
            pattern: '*.{tsv,txt}'
        ]
    }

    withName: BUILD_GS_PANEL_MANIFEST {
        publishDir = [
            path   : "${params.outdir}/gs_panel",
            mode   : 'copy',
            pattern: '*.json'
        ]
    }
}

validation {
    help {
        enabled = true
    }
    logging {
        unrecognisedParams  = 'error'
        unrecognisedHeaders = 'error'
    }
}

profiles {
    docker {
        docker.enabled = true
    }

    docker_amd64 {
        docker.enabled = true
        docker.runOptions = '--platform linux/amd64'
    }

    test {
        includeConfig 'conf/test.config'
    }
}
