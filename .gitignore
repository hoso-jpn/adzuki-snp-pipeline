# Large sequencing files
*.fastq
*.fastq.gz
*.bam
*.bai
*.vcf.gz
*.tbi
*.sra

# Reference genome files
*.fna
*.fna.*
*.dict

# Temporary files
/tmp/
*.tmp

# Python
__pycache__/
*.pyc

# Nextflow
.nextflow/
.nextflow.log*
work/
results/

# nf-test
/nf-test
.nf-test/
.nf-test.log
# nf-test writes a generated mock script per process test into the project
# root while it runs. Issue #42 made an unclean working tree a hard failure
# (a provenance manifest must not claim a HEAD commit that is not the code
# that ran), so these scratch files have to be ignored or nf-test would make
# the tree dirty against itself.
.nf-test-*.nf

# CI tooling that installs itself *inside* the workspace, for the same
# reason: `nf-core/setup-nextflow` checks its own action repository out to
# `<workspace>/setup-nextflow` before installing the engine, which is CI
# scaffolding, not a change to this pipeline's source. (The `/nf-test`
# entry above exists for the same class of thing.)
/setup-nextflow/

# Synthetic test fixtures
!tests/data/reads/*.fastq.gz
!tests/bin/fixtures/*.vcf.gz
!tests/modules/fixtures/*.vcf.gz
!tests/modules/fixtures/*.vcf.gz.tbi
!tests/data/reference/prebuilt_dict/*.dict
!tests/data/reference/prebuilt_dict_reordered/*.dict
!tests/modules/fixtures/reference_contigs/*.dict
